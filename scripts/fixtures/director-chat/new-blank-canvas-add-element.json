{
  "name": "new-blank-canvas-add-element",
  "description": "PASS2-J3 P0 (composer library on, NEXT_PUBLIC_STUDIO_NEW_SESSION_THEME_POLICY on): a NEW session gets Director's new-session frames (initial theme_sync, blank presentation_init, greeting) and never a sync_response; the theme policy resolves on the blank deck, Auto is synced, a Corporate Light pick sends set_theme, Director applies it, and Add Element > Generate passes the page's theme preflight and reaches Text Labs.",
  "elementPreflight": true,
  "elementType": "TEXT_BOX",
  "env": {
    "NEXT_PUBLIC_COMPOSER_LIBRARY_ENABLED": "true",
    "NEXT_PUBLIC_STUDIO_NEW_SESSION_THEME_POLICY": "true",
    "NEXT_PUBLIC_ELEMENTOR_URL": "https://textlabs.synthetic.invalid"
  },
  "textLabsResponse": {
    "success": true,
    "elements": [
      {"component_type": "TEXT_BOX", "html": "<div>Synthetic generated text box</div>", "content": "<div>Synthetic generated text box</div>", "grid_position": {"start_col": 5, "start_row": 4, "position_width": 10, "position_height": 6}}
    ]
  },
  "session": {"id": "synthetic-session-blank-canvas", "userId": "synthetic-user-01"},
  "steps": [
    {"op": "ensureConnected"},
    {"op": "open"},
    {"op": "expect", "themeBlocked": true, "outbound": 0, "comment": "onopen: the policy is still unresolved (no race with the deck)"},
    {"op": "frame", "comment": "Director new-session branch, 1/3: the initial theme is applied before the blank deck is published", "frame": {"message_id": "msg-initial-theme", "session_id": "synthetic-session-blank-canvas", "timestamp": "2026-10-05T12:00:01Z", "type": "theme_sync", "role": "assistant", "payload": {"request_id": "initial:synthetic-blank-02", "status": "applied", "presentation_id": "synthetic-blank-02", "theme": {"mode": "auto"}}}},
    {"op": "expect", "themeBlocked": true, "outbound": 0},
    {"op": "frame", "comment": "2/3: the blank deck (create_presentation_init payload)", "frame": {"message_id": "msg-blank-init", "session_id": "synthetic-session-blank-canvas", "timestamp": "2026-10-05T12:00:02Z", "type": "presentation_init", "role": "assistant", "payload": {"operation": "full_update", "is_blank": true, "metadata": {"main_title": "Untitled Presentation", "overall_theme": "", "design_suggestions": "", "target_audience": "", "presentation_duration": 0, "preview_url": "https://layout.synthetic.invalid/p/synthetic-blank-02", "preview_presentation_id": "synthetic-blank-02"}, "slides": [{"slide_id": "blank_slide_1", "slide_number": 1, "slide_type": "title_slide", "title": "", "subtitle": "", "narrative": "", "key_points": [], "variant_id": "H1s", "service": "text", "purpose": "title_slide"}]}}},
    {"op": "frame", "comment": "3/3: the greeting; no sync_response follows on a new session", "frame": {"message_id": "msg-greeting-blank", "session_id": "synthetic-session-blank-canvas", "timestamp": "2026-10-05T12:00:03Z", "type": "chat_message", "role": "assistant", "payload": {"text": "Hello! I'm your presentation assistant. What would you like to build today?", "sub_title": null, "list_items": null, "format": "markdown"}}},
    {"op": "checkpoint", "label": "new blank canvas"},
    {"op": "expect", "themeBlocked": false, "outboundOfType": {"set_theme": 1}, "themeSyncStatus": "syncing", "comment": "resolved as no adoption: the page syncs the default Auto theme, exactly as with the library off"},
    {"op": "themeAck", "messageId": "msg-theme-auto-applied", "timestamp": "2026-10-05T12:00:04Z"},
    {"op": "expect", "themeSyncStatus": "applied"},
    {"op": "themePick", "theme": {"mode": "preset", "preset_id": "corporate_light"}, "comment": "Theme dialog: Corporate Light"},
    {"op": "expect", "outboundOfType": {"set_theme": 2}, "themeSyncStatus": "syncing", "comment": "the pick reaches Director (it was refused before)"},
    {"op": "checkpoint", "label": "corporate light requested"},
    {"op": "themeAck", "messageId": "msg-theme-corporate-applied", "timestamp": "2026-10-05T12:00:05Z"},
    {"op": "expect", "themeSyncStatus": "applied"},
    {"op": "checkpoint", "label": "corporate light applied"},
    {"op": "generate", "comment": "Add Element > Text Box > Generate", "form": {"componentType": "TEXT_BOX", "prompt": "Three synthetic facts about ocean currents", "count": 1, "layout": "vertical", "advancedModified": false, "useDeckTheme": true, "slideIndex": 0, "textboxConfig": {}, "semanticRole": "BODY_TEXT", "geometryMode": "AUTO", "positionConfig": {"start_col": 5, "start_row": 4, "position_width": 10, "position_height": 6, "auto_position": false}}},
    {"op": "expect", "textLabsRequests": 1, "noToast": "Deck theme not ready", "comment": "the theme preflight is ready and the generation request reaches Text Labs"},
    {"op": "checkpoint", "label": "element generated"}
  ]
}
