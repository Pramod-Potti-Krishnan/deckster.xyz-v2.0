# Database Configuration
# Get your Supabase PostgreSQL connection string from: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# NextAuth.js Configuration
# IMPORTANT: Set this to your actual domain in production
NEXTAUTH_URL="http://localhost:3002"

# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-secret-here"

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Development Bypass (OPTIONAL - remove in production)
# Email address that bypasses approval requirement for testing
DEV_BYPASS_EMAIL="your-email@example.com"

# v7.5 Downloads Service Configuration
# REST API endpoint for downloading presentations as PDF/PPTX
NEXT_PUBLIC_DOWNLOAD_SERVICE_URL="https://web-production-4908a.up.railway.app"

# PDF / PPTX export in view-only mode (CA-J2F2-VIEWONLY, Studio half)
# "true" sends `view_only: true` on the PDF and PPTX requests to Downloads so
# authoring placeholders do not print. Default off (request bodies unchanged).
# Enable LAST: Layout LAYOUT_VIEW_HIDES_AUTHORING_PLACEHOLDERS_ENABLED, then
# Downloads DOWNLOADS_VIEW_ONLY_RENDER_ENABLED, then this. Useless alone.
NEXT_PUBLIC_EXPORT_VIEW_ONLY_ENABLED="false"

# Layout Service / embedded presentation viewer
NEXT_PUBLIC_LAYOUT_SERVICE_URL="https://web-production-f0d13.up.railway.app"

# Optional comma-separated exact origins approved to host the Layout viewer.
# The origin of NEXT_PUBLIC_LAYOUT_SERVICE_URL is always approved automatically.
# Keep this empty in UAT so restored production viewer URLs fail closed.
NEXT_PUBLIC_LAYOUT_VIEWER_ALLOWED_ORIGINS=""

# Present and audience viewer paths in view-only mode (A4)
# "true" opens the Layout viewer with ?viewOnly=true for full-screen Present (a separate
# view-only frame over the editing frame), the chat "Open" link and the dashboard preview,
# so authoring placeholders ("Generate image...", "IMAGE / Click to configure", stock copy)
# are hidden. Default off (URLs and behaviour unchanged). Enable AFTER Layout
# LAYOUT_VIEW_HIDES_AUTHORING_PLACEHOLDERS_ENABLED (Layout !203). Useless alone.
NEXT_PUBLIC_PRESENT_VIEW_ONLY_ENABLED="false"

# Composer template library, "Rebuild from own content" (Stage 1B gate G3, ditto). Exact "true" enables it; default off.
# Adds the action next to "Use original" and lets the composer-library proxy forward mode "ditto" (only that value,
# never together with a brief) on templates/{id}/use. Needs NEXT_PUBLIC_COMPOSER_LIBRARY_ENABLED="true" and Director's
# COMPOSER_STAGE1B_DITTO_ENABLED; the backend job makes no model calls. Client-visible by design.
NEXT_PUBLIC_COMPOSER_STAGE1B_DITTO_ENABLED="false"

# Elementor Service (Visual Elements Orchestrator)
# Generates AI content (images, charts, diagrams, etc.) and auto-injects into Layout Service
NEXT_PUBLIC_ELEMENTOR_URL="https://web-production-3b42.up.railway.app"

# Add Element text box / metrics request fidelity (UAT J3-F1/F4). Literal "true" = on.
# On: an Auto Count is not sent (Text Labs resolves it from the prompt), list_style is
# sent as bullets|numbers|none, and state behind hidden controls is not sent. Default off.
NEXT_PUBLIC_TEXTBOX_REQUEST_FIDELITY_ENABLED="false"

# Add Element table panel, manual structure (R10). Literal "true" labels the row picker "Data rows" (visible text and
# aria-label) and adds the hint "The header row is added on top." Display only: the row count sent is the number picked,
# which the Text Service already treats as data rows (headers are separate slots). Default off: the panel is unchanged.
NEXT_PUBLIC_TABLE_DATA_ROWS_LABEL_ENABLED="false"

# Theme Builder Service
# Lists build-time theme presets and prepares Theme Builder v2 sessions via Director
NEXT_PUBLIC_THEME_BUILDER_URL="https://theme-v1.up.railway.app"
# Theme picker (T-07/T-06): offer all ten Theme Builder canon presets and take each
# swatch from TB's own preset contract (GET /api/v1/themes/presets/{id}). Default off.
NEXT_PUBLIC_THEME_PICKER_CANON_ENABLED="false"

# Studio deck-theme picker, lighter and clearer (PASS2 #7). Exact "true" enables it; default off. Needs the Studio shell
# (NEXT_PUBLIC_STUDIO_V4_SHELL). On: the in-builder theme panel becomes a compact picker. Preview tiles show each theme's colours
# ("Aa", content ground, title ground, lead colour), the current theme is named and marked, the "locked" note is plain words and
# appears only once the deck is building or built, and Cancel / Apply theme are the two obvious buttons. Same presets (all ten with
# the canon flag above), same custom palette and overrides, same Apply and the same lock rule; only the presentation changes. Off: unchanged.
NEXT_PUBLIC_STUDIO_THEME_PICKER_V2="false"

# Studio theme picker as a searchable dropdown (PASS2-PK-FOUR item 3). Exact "true" enables it; default off. Needs the Studio shell
# (NEXT_PUBLIC_STUDIO_V4_SHELL). On: the preset choice in the in-builder theme picker becomes a dropdown (type to search, arrow keys,
# Enter to pick, Escape closes) with the current theme pinned at the top and Auto first, each row showing the name and 4-5 colour
# swatches, plus a preview of the selected theme (title ground, content ground, lead and accent colours, fonts) on a sample title and
# body. Nothing is applied to the deck until Apply theme. Same presets and order, same custom palette and fine-tune, same Apply payload
# and lock rule. Takes the place of the PASS2 #7 grid (NEXT_PUBLIC_STUDIO_THEME_PICKER_V2) when both are on. Off: unchanged.
NEXT_PUBLIC_STUDIO_THEME_DROPDOWN="false"

# Theme fonts in the Studio (J4-FONTS, Studio half). Literal "true" adds Heading font and Body font pickers
# (Inter, Poppins, Roboto, Open Sans, Lato, Montserrat, Playfair Display, Lora) to Themes, keeps the choice through
# preset switches, saved profiles, the standard theme and the session, and sends it as `font_family` (body) and
# `font_family_heading` in `data.theme`. Absent when not chosen, never null. Default off: no UI, no font keys.
# Enable LAST: Theme Builder TB_FONT_SELECTION_ENABLED (!52), then Director DIRECTOR_THEME_FONT_SELECTION_ENABLED
# (!466), then this. With a backend still off, a saved theme comes back without its fonts and the Studio says so.
NEXT_PUBLIC_THEME_FONT_SELECTION_ENABLED="false"

# P2C: Light or Dark for the whole deck, chosen before the build (Studio half). Literal "true" adds a Light | Dark control to the deck theme panel
# (preset and custom) and sends the choice as `palette_mode` ("light" or "dark", never "both") on the theme selection that already goes out in the
# build message and the set_theme frame; Themes & brand offers the same two choices. Default Light. A built deck cannot be switched from the browser:
# there the control reads "Rebuild in dark" / "Rebuild in light" and only STAGES the choice for the next rebuild (nothing is rebuilt or sent).
# Default off: no control, and the payload and the panel are exactly as before. Needs the dark chain on first: Theme Builder TB_DARK_MODE_ENABLED,
# Director DIRECTOR_PALETTE_MODE_PASS_ENABLED, Slide Builder's dark stamping, Layout LAYOUT_DARK_MODE_ENABLED (already on in UAT).
NEXT_PUBLIC_THEME_DARK_MODE_ENABLED="false"

# P2C follow-up: keep a Dark (or Light) picked in the theme panel on a PRESET. Literal "true" (and only while NEXT_PUBLIC_THEME_DARK_MODE_ENABLED is "true" too):
# (1) the composer's quick picks (preset chip, brand colour, saved theme) carry the panel's `palette_mode` onto the theme they pick (a saved theme that holds its
# own mode keeps it; Auto stays a reset; dark-only presets still end on Dark), and (2) the stored-selection restore (a session reload, saved theme included) and
# the Director theme restore keep `palette_mode` on a preset instead of dropping it. Default off: every one of those paths is exactly as before. Studio only.
NEXT_PUBLIC_STUDIO_THEME_DARK_PERSIST="false"

# THEME-RESET-ON-RECONNECT-P1, Studio half: keep the session's stored theme when a tab connects. Exact "true" enables it;
# default off, and then the Builder is exactly as before. Pairs with Director's DIRECTOR_THEME_RESTORE_ON_CONNECT_ENABLED
# (!485), which sends the stored theme once per connect as theme_sync {status: "restored"}: switch Director on FIRST.
# On: the Builder shows that theme (null: Auto) and no longer sends the socket-ready set_theme that overwrote it with a
# second tab's or a fresh reload's local Auto; a theme the user picks is still sent at once, and wins over a later restore.
# A Director without the restore is detected per socket (the first frame after sync_response, or a new session's greeting)
# and the Builder then syncs as today. A restore of a theme another tab is still applying (Director acknowledges an apply
# only to the socket that asked) counts as applied: no 20 s timer, no timeout banner. A session whose user never picked a
# theme (the restore id ends in ":none": the theme is Director's own default for the blank deck it auto-themed at creation,
# e.g. Corporate Light) stays on Auto, with no "Theme selected" chip, and sends nothing; a theme the user picked (Auto
# included) is shown as chosen. No new frame type is sent and nothing new is saved.
NEXT_PUBLIC_STUDIO_THEME_RESTORE="false"

# J7-RESUME-LOOP-P1, Studio half: Resume must survive a Stop. Exact "true" enables it; default off, and then the build narration is
# exactly as before. READ AT BUILD TIME: set it on Vercel, then redeploy. Pairs with Director's DIRECTOR_RESUME_AFTER_STOP_ENABLED (!490).
# After a Stop, Director publishes the partial deck's presentation_url. Off: that URL completes the stopped build (unbuilt slides counted
# as built): the ribbon reads "Your deck is ready", then closes 1.6 s later with its Resume button, Export/Publish appear, and the viewer
# reloads once (Studio expects more slides than the deck has); a typed "resume" then cannot reopen the ribbon (Director's building phase
# for the same build is ignored once complete) until the page is reloaded. On: while the build is stopped, the URL updates the deck only;
# "Stopped — your progress is saved" with Resume stays (also through a reload) until Director's next build_phase (Resume, a typed resume)
# or a new build; as before the URL, Export/Publish stay hidden while stopped and the viewer is not reloaded. No frame, request or saved
# field changes.
NEXT_PUBLIC_STUDIO_BUILD_RESUME_FIX="false"

# Composer template library, long new-topic brief (ask 14). Exact "true" raises the brief limit from 4,000 to 16,000
# characters in the dialog and the composer-library proxy, and lets the proxy accept a 65,536-byte body on
# templates/{id}/use only (other routes stay 16,384). Needs NEXT_PUBLIC_COMPOSER_LIBRARY_ENABLED and
# NEXT_PUBLIC_COMPOSER_STAGE1B_NEW_TOPIC_ENABLED, plus Director's COMPOSER_LONG_BRIEF_ENABLED (without it Director
# refuses a brief over 4,000). Default off. Client-visible by design.
NEXT_PUBLIC_COMPOSER_LONG_BRIEF_ENABLED="false"

# Add Element, Creative infographic stage-name caption row (R14, Studio half). Exact "true" inserts the `caption_row` Text Labs
# returns as its own text element directly under the picture (the picture shrinks to make room), saves it with the slide, and
# asks a variation for the original area. Unset or anything else: the picture only, as today. Roll out Text Labs
# TL_INFOGRAPHIC_CAPTION_ROW_ENABLED first, then this. Default off. Client-visible by design.
NEXT_PUBLIC_INFOGRAPHIC_CAPTION_ROW_ENABLED="false"

# Director HTTP host for authenticated Next.js proxies (templates, saved themes)
DIRECTOR_API_URL="https://directorv33-production.up.railway.app"

# Director WebSocket + short-lived browser authentication
# Use the same DIRECTOR_WS_AUTH_SECRET on Vercel and the Director Railway service.
# KG activation fails closed on Director when this secret is missing.
# Generate independently (for example: openssl rand -base64 48). Server-only.
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws"
DIRECTOR_WS_AUTH_SECRET=""

# Researcher Knowledge Graph proxy
KNOWLEDGE_SERVICE_URL="https://researcher-v1.up.railway.app"
KNOWLEDGE_API_KEY="replace-with-the-shared-researcher-director-secret"

# Slide Composer (compose one whole slide through Director REST)
# Default off until Director + Slide Builder producer paths are merged and canaried.
NEXT_PUBLIC_SLIDE_COMPOSER_ENABLED="false"
SLIDE_COMPOSER_DIRECTOR_URL="http://localhost:8000"

# Template Ingest (upload PPTX/PDF -> reusable template; contract C-7)
# Requires NEXT_PUBLIC_TEMPLATE_BUILDER_ENABLED=true as well. Default off.
NEXT_PUBLIC_TEMPLATE_INGEST_ENABLED="false"

# Studio J2 fixes ("add a generated slide"). Each is read as the exact string "true"; default off.
# J2-F4: after an Add/Duplicate/Delete ack, the thumbnail-rail count and the footer "Slide x / y" move together.
NEXT_PUBLIC_STUDIO_SLIDE_COUNT_SYNC_ENABLED="false"
# J2-F7: after a synchronous Slide panel generation the viewer goes to the new slide (not slide 1),
# and the panel's Generate button stays put while the prompt is typed.
NEXT_PUBLIC_STUDIO_GOTO_NEW_SLIDE_ENABLED="false"
# J2-F5: opening the Slide panel resizes the canvas (and the Layout iframe) in one step instead of
# animating it through ~19 intermediate sizes. A mitigation for a suspected cause; verify in Studio dev.
NEXT_PUBLIC_STUDIO_PANEL_KEEP_CANVAS_ENABLED="false"

# PASS2-PK-FOUR #1: the Studio builder top bar as in the accepted v4 mockup. Exact "true" enables it; default off, and then the
# top bar is exactly as before. Needs the Studio shell (NEXT_PUBLIC_STUDIO_V4_SHELL).
# On: left, the sidebar toggle, then "Workspace / <deck name>" ("Workspace" opens your decks) and a quiet "Saved" when the deck on
# stage reports itself saved (the viewer's existing autosave state; nothing is shown while it saves, has unsaved changes or failed,
# because the toolbar's save control already shows those); right, "+ New deck" (the "+ Presentation" button renamed, same action),
# "Export" with a menu chevron (the Download button renamed: same PDF / PPTX menu and handlers) and Publish, at the mockup's sizes,
# spacing, icons and borders. Undo / redo and the mockup's status pill are not shown. Presentation only: no new request or save.
# With NEXT_PUBLIC_STUDIO_SESSION_HYGIENE also on, "Saved" needs a history row too: a bare /builder (an unsaved local session whose blank
# deck the viewer already calls saved) shows no "Saved" until the first real action writes the row. Hygiene off: as above.
NEXT_PUBLIC_STUDIO_TOP_BAR_V2="false"

# PASS2-PK-FOUR item 4: the template upload "wow" workspace (frames streams/ops/PASS2/PK4-4-template-wow). Exact "true" enables it;
# default off, and then the upload dialog, the top bar, the toolbar's Template entry and the Templates page are exactly as before.
# Needs the Studio shell (NEXT_PUBLIC_STUDIO_V4_SHELL). On: the upload dialog takes PowerPoint (.pptx) only and says in plain words why
# another file cannot be used; after the upload the builder opens the template workspace: the as-is deck once Director reports it
# (`as_is_ready`), each slide queued -> analysing -> locked (or kept as-is), "Locking template: n/N" in the top bar, browse and
# Present throughout, Edit once the template is ready, then "Template ready". Template ▾ sits next to Theme (your templates, a preview,
# New topic / Reuse as-is, Upload a template); the Templates page shows uploads still locking. Picking a template creates a new deck.
# The events come from Director's template job status: until COMPOSER-2 / Director emit them (S4/S5) the workspace waits in its
# "converting" state, so keep this off outside dev/test.
# Fix-forward (same flag): with the composer library on (NEXT_PUBLIC_COMPOSER_LIBRARY_ENABLED), Template ▾ also lists the library's own templates
# (the composer's template popup's list: the library dialog's request, only while open and signed in) ahead of this tab's uploads. Picking one shows the
# dialog's actions (Use original, plus Rebuild from own content and New topic behind their own flags), which the library dialog runs with its own
# handlers; "Template library" opens that dialog, and /studio/templates is linked only where it works (NEXT_PUBLIC_TEMPLATE_BUILDER_ENABLED); an empty,
# loading or failed list says why in plain words. With no composer library the picker is as before. Studio shell only, like the picker itself.
NEXT_PUBLIC_STUDIO_TEMPLATE_WORKSPACE="false"

# Dev/test ONLY, read at BUILD time: feeds the template workspace from a deterministic mock event source (a fictional 30-slide deck)
# instead of Director, so the whole flow runs with no backend. A build without it contains no mock code. Never set it for UAT or
# production. Optional sessionStorage `deckster_template_workspace_mock` picks a scenario (happy, unlockable, paused, failed,
# failed_convert, long, over_cap) and a pace (demo, real).
NEXT_PUBLIC_STUDIO_TEMPLATE_WORKSPACE_MOCK="false"

# PASS2 #3: Add Slide / Add Element no longer squeeze the canvas (Studio shell). Exact "true" enables it; default off.
# On: while the Add Slide panel or the Add Element panel is open, the chat and the slide rail step aside, so the slide keeps
# most of the width; when the panel closes both come back exactly as they were (open or closed, same width, same chat draft).
# The Director and Thumbnails handles stay on screen and bring their pane back for that panel. The chat collapses only in
# the side-by-side layout (1100 px workspace and wider). Off: the panel opens beside the chat and the rail, as before.
NEXT_PUBLIC_STUDIO_PANEL_FOCUS="false"

# J2 v2: generate-first "Add slide" SIDE PANEL in Studio (PK feedback J2-P1..P11). Exact "true" enables it; default off.
# On: the Add Slide button opens a panel in the Element drawer (same frame as Add Element) with slide type (title /
# section / closing / content), a content style, one "What should this slide say?" box, "Blank slide", and the chat's
# research and theme read-only. Off: the existing layout picker, unchanged. Generate also needs
# NEXT_PUBLIC_SLIDE_COMPOSER_ENABLED and NEXT_PUBLIC_SLIDE_COMPOSER_ASYNC (the same two the Slide panel's async path
# uses); without them the panel opens but Generate stays disabled.
NEXT_PUBLIC_STUDIO_ADD_SLIDE_V2_ENABLED="false"

# PASS2 #2: the Studio first-run home, closer to the accepted v4 mockup. Exact "true" enables it; default off, and then the
# first-run screen is exactly as before. Needs the Studio shell (NEXT_PUBLIC_STUDIO_V4_SHELL).
# On: while nothing has been said yet in a session (no message from you, and Director has said no more than its opening
# greeting), the chat is one centred column: a serif "What story are we telling today?", one line of guidance, Director's
# greeting, the same three starters and the same composer (send, upload, research toggles and the theme chip are untouched).
# The stage and its toolbar and slide rail stay mounted but out of sight; Replay intro, Explore templates and Start on a
# blank canvas (the last only when a blank deck exists) move into one small row under the starters. Your first message,
# Start on a blank canvas, or an opened Add Slide / Add Element panel brings the usual chat + stage layout back.
# The welcome waits for a confirmed new session: while an existing session's history is still loading it is not drawn and the stage
# is not hidden (the page's own loading states show instead), so an existing deck never flashes it.
# Presentation only: no new message, request or save. Off: unchanged.
NEXT_PUBLIC_STUDIO_FIRST_RUN_V2="false"

# PASS2-PK-FOUR #2: Studio composer placeholder in plain words. Exact "true" enables it; default off, and then the composer reads
# "Message Director..." exactly as before. Needs the Studio shell (NEXT_PUBLIC_STUDIO_V4_SHELL).
# On: when the composer is idle (signed in, connected, nothing pending) its placeholder reads "Ask for a change, or describe a new
# deck…" while the session has a deck open, and "What would you like to present?" in a session with no deck yet. The state wordings
# ("Connecting...", "Director is replying…" and the rest), the accessible name, the send handlers and every message are untouched.
# Wording only: no new message, request or save.
NEXT_PUBLIC_STUDIO_COMPOSER_COPY="false"

# J2 v2 per-option switches (no code change). Option ids:
#   slide types   title, section, closing, content
#   content styles auto, text, image_left, image_right, chart, infographic, table, diagram
#   extras        blank (Blank slide), catalog (the "Browse layout catalog" link),
#                 blank_theme (Blank slide takes the deck theme background; off = Layout's plain white blank),
#                 regenerate ("Regenerate this slide" for a generated slide, see NEXT_PUBLIC_STUDIO_SLIDE_REGENERATE_ENABLED below)
# ONE rule: hidden = (default-hidden ids) + DISABLED - ENABLED, and DISABLED always wins.
#   default-hidden = the stage-2 ids (chart, infographic, table, diagram; DEC-P8: stage 1 is proven first) and
#                    regenerate. Stage 1 (title, section, closing, auto, text, image_left, image_right) shows by default.
#   NEXT_PUBLIC_STUDIO_ADD_SLIDE_V2_DISABLED_OPTIONS: comma list of ids to HIDE. Additive: it never shows anything.
#   NEXT_PUBLIC_STUDIO_ADD_SLIDE_V2_ENABLED_OPTIONS:  comma list of ids to SHOW from the default-hidden set; the
#       word "all" shows every stage-2 id (not regenerate, which must be named). Naming a stage-1 id does nothing.
# Unset or blank = an empty list. Unknown ids are ignored (so "none" is not special any more). Examples:
#   (both unset)                  stage 1 only
#   DISABLED="image_left"         stage 1 minus image_left; stage 2 STILL hidden
#   ENABLED="chart"               stage 1 plus chart
#   ENABLED="all"                 stage 1 plus all of stage 2
#   ENABLED="all" DISABLED="table"  everything but table
#   ENABLED="chart" DISABLED="chart"  chart hidden (DISABLED wins)
# NEXT_PUBLIC_STUDIO_ADD_SLIDE_V2_DISABLED_OPTIONS="image_left"
# NEXT_PUBLIC_STUDIO_ADD_SLIDE_V2_ENABLED_OPTIONS="chart,table"

# J2V2-REGENERATE: "Regenerate this slide" in the Add Slide panel (PK: "I should be able to regenerate a title too"). Exact
# "true" enables it; default off. For a generated slide on screen (title, section, closing or content) the panel shows an
# Add / Regenerate switch. Regenerate rebuilds that slide IN PLACE through the Slide panel's own Refine route
# (/api/slides/refine -> Director refine-one): the original stays on screen until the new slide is ready, then the new one
# takes its place at the same position; a failure keeps the original and shows the error. A title, section or closing
# stays a hero (Director refines heroes restyle-only). The box is pre-filled from the slide's original instruction.
# Needs NEXT_PUBLIC_STUDIO_ADD_SLIDE_V2_ENABLED, NEXT_PUBLIC_SLIDE_REFINER_ENABLED, NEXT_PUBLIC_SLIDE_COMPOSER_ENABLED and
# NEXT_PUBLIC_SLIDE_COMPOSER_ASYNC (without the last three the section is shown but disabled), AND the option id
# `regenerate` in the enabled list, for example NEXT_PUBLIC_STUDIO_ADD_SLIDE_V2_ENABLED_OPTIONS="regenerate,chart"
# (it is off by default; DISABLED_OPTIONS="regenerate" hides it again). "Generated" means the frontend knows it: built in
# this session by a compose or refine job, or built by the deck build (the Director's slide context, remembered by slide id
# the first time it lined up with the deck, so later inserts and reorders do not lose it; a deck that had already changed
# before the page saw it is not guessed at, and a manual layout is never regenerable).
NEXT_PUBLIC_STUDIO_SLIDE_REGENERATE_ENABLED="false"

# PASS2B J2-04: what became of the slide Generate queued, in the Add Slide panel. Exact "true" enables it; default off, and then the
# panel is exactly as before. After Generate the panel stays open and, with panel focus, the slide rail is collapsed, so the rail's
# "Building slide..." card and its retry are out of sight and "Queued. It appears right after slide 2 when it is ready." stays up.
# On: ONE status line under "Queued", read from the page's own compose-job records (the ones the rail draws): "Building...", then
# "Added as slide 3 · Go to slide" (the viewer's go-to a rail thumbnail uses) or "Couldn't build it · Try again" (the rail card's own
# retry). The stale "Queued" note is dropped once the slide is added or failed. No backend call, no new frame. Needs
# NEXT_PUBLIC_STUDIO_ADD_SLIDE_V2_ENABLED, NEXT_PUBLIC_SLIDE_COMPOSER_ENABLED and NEXT_PUBLIC_SLIDE_COMPOSER_ASYNC (the panel's Generate).
NEXT_PUBLIC_STUDIO_ADD_SLIDE_STATUS="false"

# J2-SILENT-FAIL: an async slide-compose job (Add slide side panel, Slide panel) can no longer disappear without a word.
# Exact "true" enables it; default off, and then the page is exactly as before. On: (1) a job with no outcome and no sign of
# life for 5 minutes (+ 3 minutes per pending job ahead of it on the same deck, never more than 25 minutes from acceptance)
# becomes a visible error card in place of the placeholder, in plain words, with Retry and Dismiss; the job-status route
# (/api/slides/jobs/{id}) is asked at the deadline to pick the wording, and a job it still reports as building gets another
# interval instead, never past the 25 minutes. (2) The minimal job record, request included, is kept
# in sessionStorage per session + deck; a reload re-checks each record once and shows it as pending, as the error, or not at all
# (the slide landed). Retry re-sends the stored request; Dismiss removes the card and the record. Needs the Slide Composer flags.
NEXT_PUBLIC_STUDIO_COMPOSE_JOB_FAILSAFE_ENABLED="false"

# PASS2 #8: error / loading / session hygiene for the Studio Builder. Exact "true" enables it; default off, and then the
# Builder, the route loader and the 404 page are exactly as before. On: (1) a bare /builder (or ?session_id=new) is a local,
# unsaved session: no history row ("Untitled Session") is written until the first real action (first message, an upload,
# a manual-deck handoff, or the first state-changing click on the blank canvas: a theme or template pick, a manual Add Slide /
# Duplicate / Delete / Reorder, a manual Add Element; that click saves the row so the session also opens in a second tab, and
# the blank deck's URL/id Director sent before it is written once), and a reload of that URL writes none either; nor does
# Director's blank-deck update (session metadata is written only for a saved session, and a session the history returns counts
# as saved); (2) /builder?session_id=<id> for an
# id this account does not have shows a "session not found" state (a deleted one says so; a failed lookup offers Try again) instead of
# silently creating an empty session; (3) the route loader is the builder shell skeleton (needs NEXT_PUBLIC_STUDIO_V4_SHELL);
# (4) unknown routes get a Studio-styled 404 page. Needs no backend change.
NEXT_PUBLIC_STUDIO_SESSION_HYGIENE="false"

# MULTITAB J1 P1a: a reload at the outline-approval step left the canvas on "Loading your selected deck..." for good. Exact "true" enables
# the fix; default off, and then the Builder is exactly as before. On: (1) the Layout slide-count reconcile never saves Director's
# untouched one-slide blank deck to the session (what the canvas shows is unchanged), and slides added on the blank canvas are saved
# to the session's BLANK slots, never its final ones (the same split for slide-compose completions); (2) when the session restore
# commits, a local deck override it did not restore is retired, so the canvas never waits for an owner that cannot come; (3) the
# blank deck Director sent before the first message (held by NEXT_PUBLIC_STUDIO_SESSION_HYGIENE) is saved with the first-message
# save, so a reload restores the blank canvas. Existing rows are not repaired. Studio page only: no WebSocket change, no backend change.
NEXT_PUBLIC_STUDIO_BLANK_DECK_RELOAD_FIX="false"

# J3-BLANK-START-SESSION: after "Deckster was updated · Reload now" Studio showed the brief page for an existing blank-canvas deck, and
# "Start on a blank canvas" reopened that deck instead of making a new one. Exact "true" enables the fix; default off, and then the
# Builder is exactly as before. On (Studio shell only): (1) starting a session's blank canvas is remembered per account and session in
# this browser (localStorage, newest 50 sessions), so a reload of that session opens on its canvas, not the brief page; (2) the first-run
# "Start on a blank canvas" on a session that already holds a started deck (and has a saved row) opens a NEW session with the Builder's
# own New flow and starts that session's blank canvas once its blank deck arrives. A just-started, unsaved canvas is unchanged.
# No new requests, no backend change.
NEXT_PUBLIC_STUDIO_BLANK_START_NEW_SESSION="false"

# J3-EMPTY-PROMPT-GUARD (J3 pass 2, R5-9): in Add Element the "Generate (⌘↵)" button stayed enabled with an empty "Generation prompt", so a
# paid generation could be fired with nothing to generate from. Exact "true" enables the guard; default off, and then the panel is exactly as
# before. On: while the prompt is empty or only whitespace, Generate is disabled (aria-disabled, hint "Describe what you want to generate") and
# Cmd/Ctrl+Enter and the error box's retry do nothing, for a NEW element only and only where the prompt is required. Left open: Chart with
# Custom JSON data, a preset Shape, an Infographic with a reference image or manual rows, Refine / Edit current, and "Check generation result".
# Frontend only: no new requests, no backend change.
NEXT_PUBLIC_STUDIO_EMPTY_PROMPT_GUARD="false"

# J3-SHAPE-FILL-CONTRAST-FE (J3 pass 2, P3): a shape with Fill on "Auto (deck)" is painted by Text Labs in the deck primary on an assumed light
# ground, so on a dark slide (a navy hero) it is navy on navy. Exact "true" enables it; default off, and then the request is exactly as before.
# On: with Fill Auto and Background not set by the user, the Shape form adds shape_config.target_background = the current slide's ground as
# "#rrggbb" (viewer getTemplateSlotCatalog canvas_type + the deck's /theme/css-variables: --theme-hero-bg on H* slides, --theme-bg elsewhere;
# a gradient or unknown ground sends nothing). Works with Text Labs TL_SHAPE_FILL_CONTRAST_ENABLED; harmless to a Text Labs that has it off.
# No new requests, no Layout change.
NEXT_PUBLIC_STUDIO_SHAPE_TARGET_BACKGROUND="false"

# J4-01 (J4 pass 2B, P3): in the composer's Build theme popover (Manage themes), Delete removes a saved theme from the shared library on one click:
# no confirm, no undo. Exact "true" enables it (Studio shell only); default off, and then Delete is exactly as before.
# On: Delete hides the theme and opens a 6 s undo window (an "Undo" in the popover plus a "Theme deleted" toast with an Undo action); no request is
# made until the window runs out; Undo restores the theme with no write; picking another theme meanwhile commits the delete first; leaving the page
# sends nothing (the theme is kept). Frontend only: no new request, no backend change.
NEXT_PUBLIC_STUDIO_THEME_DELETE_UNDO="false"

# PASS2B batch 1, J3-01 / J5-01 / J6-01 (greyed controls say why): the Add Slide, Add Element, Template and Theme buttons went grey with no word on
# screen, and the Add Element panel's greyed research sources kept their reason in a hover-only title. Exact "true" enables it; default off, and
# then every control is exactly as before. On: a greyed toolbar button takes keyboard focus and shows its reason in a tooltip on hover AND focus
# ("Loading the slide…", "Exit Template Mode to add elements", "Finishing your last change…", or the ONE_LIVE_TAB paused-tab sentence), with
# role="button" + aria-disabled + the reason as aria-describedby; the Add Element cards show the reason on one line in the gallery; a greyed research
# source shows its reason on a visible 10px line under the sources row. Extends the wrapper NEXT_PUBLIC_STUDIO_ONE_LIVE_TAB added. Frontend only.
NEXT_PUBLIC_STUDIO_DISABLED_REASONS="false"

# PASS2B batch 1, J3-05 (a status line while an element generates): the send button became a bare spinner, nothing said what was happening or how
# long, and Escape was ignored while the header's ✕ still worked. Exact "true" enables it; default off, and then the panel is exactly as before.
# On: "Generating chart… usually 10–30 s" (Image and Infographic: 60–90 s; the other types name what is generating, no number) in an aria-live
# "polite" line under the prompt box, and Escape closes the panel while generating exactly as the ✕ does (the same onClose; it hides the panel and
# does not abort the request). An Escape typed in a text field outside the panel is left alone. Frontend only.
NEXT_PUBLIC_STUDIO_GENERATING_STATUS="false"

# PASS2B batch 2, J3-02 (focus the prompt box when an Add Element form opens): nothing focused the "Generation prompt" box, and closing the Radix menu
# that picked the element returned focus to the Add Element button, so the first keystroke went nowhere (Add Slide already focuses its box). Exact
# "true" enables it; default off, and then the panel is exactly as before. On: a NEW element opened in generate mode focuses the box once the menu has
# closed and Radix has restored focus to its trigger. Never in edit or refine mode, never over focus already inside the panel, in another text field or
# in an open menu/dialog, never into a box that takes no text, never in a hidden drawer. Frontend only.
NEXT_PUBLIC_STUDIO_PROMPT_AUTOFOCUS="false"

# PASS2B batch 2, J3-09 (a preset shape does not use the prompt): the Shape form sends prompt: null for every preset (only Custom reads it), yet the
# prompt box showed "e.g., a red star" and took text that was silently dropped. Exact "true" enables it; default off, and then the panel is exactly as
# before. On: with a preset selected the prompt box is read-only and aria-disabled and says "Presets don't use a prompt. Choose Custom to describe a
# shape." under it; the typed text is kept and returns when Custom is chosen again. Custom, the request and the empty-prompt guard are unchanged.
NEXT_PUBLIC_STUDIO_SHAPE_PRESET_PROMPT_HINT="false"

# PASS2B batch 2, J5-09 (why Save as Template is greyed): the Save button went grey for four different reasons and said nothing. Exact "true" enables
# it; default off, and then the dialog is exactly as before. On: the first unmet reason is shown under the Save button and the button is described by it:
# "Add a name to save this template." / "Open a deck to save it as a template." / "Finish building the deck before saving it as a template." / "Loading…".
NEXT_PUBLIC_STUDIO_TEMPLATE_SAVE_REASONS="false"

# Studio slide rail keyed by slide_id (F8 / S-03, frontend half). Exact "true" enables it; default off.
# Reads Layout's GET /api/presentations/{id}/slides/inventory (needs Layout LAYOUT_SLIDE_THUMBNAILS_ENABLED
# and, for previews, Slide Builder STAGE_F_THUMBNAIL_IDENTITY_ENABLED). Absent endpoint = today's rail.
NEXT_PUBLIC_STUDIO_RAIL_SLIDE_IDENTITY_ENABLED="false"

# MULTITAB J2 P1: a second tab never learned that the first one changed the deck (7 slides in one, 6 in the other) and said nothing. Exact
# "true" enables the notice; default off, and then the Builder is exactly as before (no channel, listener, timer or request). On: a tab
# that changes the deck (slide add / delete / duplicate / reorder / layout, element create / delete, a theme the user applied, a Director
# deck_mutation) posts one small message (ids and a kind, no personal data) on a BroadcastChannel keyed by session id + presentation
# id; another tab on the same deck shows a calm "This deck changed in another tab - Reload deck" and reads the slide inventory once
# through the existing endpoint. A tab that becomes visible or focused also reads it once (throttled) and shows the same notice when the
# slide count or inventory differs (covers another browser profile or device). Reload deck reuses the existing deck reload and is always
# the user's click; with unsaved edits in that tab it asks first. Studio page only: no WebSocket change, no backend change, no new endpoint.
NEXT_PUBLIC_STUDIO_DECK_CHANGED_NOTICE="false"

# F9-A: a rail card whose slide will never get a thumbnail (inventory thumbnail_status "none": manual, catalog and blank slides,
# or a failed Stage F registration) shows a live view-only mini-preview of the slide instead of "No preview". Exact "true"
# enables it; default off, and then the rail is exactly as before. Needs the rail identity flag above (that is where "none" comes
# from). Each frame is the view-only Layout viewer on that slide (same approved origin as the canvas): mounted only while its card
# is on screen, at most 3 at a time across the rail (the rest keep "No preview" until a slot frees), dropped at once if a real
# thumbnail arrives. A card Layout reports "pending" or "stale" with no thumbnail URL counts too, but only after 15 s of being seen
# that way (a timer in the browser; Layout can say "pending" for ten minutes about a slide that will never get a preview, and
# "stale" with no URL is a card whose image is gone). "stale" WITH a URL keeps showing that image.
# No extra backend call and no polling beyond the frame's own page load.
NEXT_PUBLIC_STUDIO_RAIL_LIVE_PREVIEW_FALLBACK_ENABLED="false"

# PASS2 rail v2: the Studio slide rail as in the accepted v4 mockup (readable labels, real slide thumbnails). Exact "true" enables
# it; default off, and then the rail is exactly as before. Studio shell only (NEXT_PUBLIC_STUDIO_V4_SHELL).
# - Labels: a one-line "01 Title" row above each preview; the title has the row's width (refine shows over the row's end on hover
#   or focus instead of holding a slot), ends in an ellipsis, and its full text is the tooltip. The rail opens at 140 px (was 120;
#   a width the user dragged to is still remembered).
# - Thumbnails: lifts the F9-A live-preview cap above from 3 to 12 frames, so every card on screen shows its slide instead of
#   "No preview" from the 4th card down; a loaded frame hides the placeholder under it. Frames still mount only while their card
#   is on screen. The thumbnail half needs the two rail flags above (both on in Studio dev).
NEXT_PUBLIC_STUDIO_SLIDE_RAIL_V2="false"

# PASS2 #5: Studio builder toolbar cleanup. Exact "true" enables it; default off, and then the toolbar and the slide footer are
# exactly as before. Studio shell only (NEXT_PUBLIC_STUDIO_V4_SHELL).
# On: (1) the toolbar no longer shows the greyed-out "Template" button with the tooltip "Templates - coming soon" (it only shows when
# NEXT_PUBLIC_TEMPLATE_BUILDER_ENABLED is not "true", i.e. when saved templates are not connected; with that flag on, the working
# Template menu is shown as before). Format stays: it is only unavailable until an element is selected, and works once one is.
# (2) Present moves from the slide footer ("Slide 1 / 62 [Present]") to the end of the toolbar strip, as in the accepted mockup,
# filled like the other primary actions; the footer keeps the slide position. Presenting itself is unchanged, and Present stays
# where it was in fullscreen (as Exit). Presentation only: no new request, message or save.
NEXT_PUBLIC_STUDIO_TOOLBAR_CLEANUP="false"

# S-03: a Director deck_mutation frame (chat add/delete/replace/reorder) for the DISPLAYED deck reloads the viewer and
# re-reads the rail inventory. Exact "true" enables it; default off (the frame is then dropped, as today).
# Director only sends the frame when NEXT_PUBLIC_CHAT_DIRECTIVES advertises client_caps ['mdc1'].
NEXT_PUBLIC_STUDIO_DECK_MUTATION_REFRESH_ENABLED="false"

# RUN-1 J1 R1/R2 (re-implementation of #340 on Studio). Exact "true" enables both; default off, and then history cards and
# slide titles render exactly as today.
# R1: after a reload, a Director question card becomes the disabled "Answered" card only when a later user turn exists in the
# transcript (a native plan/outline gate: only its own button echo). A deck, a card's position or a later Director frame never
# retires a card, so pending questions, the plan gate, "Generate final deck" and a replayed gate stay live.
# R2: a missing slide title no longer shows the raw slide_type "closing_slide" / "title_slide" / "section_divider" in the rail.
NEXT_PUBLIC_STUDIO_HISTORY_ACTION_STATUS_ENABLED="false"

# Ask-card identity (RUN-J1J3-FINAL D-A1/D-A2/NEW-E1). "true" (exact) makes an answer belong to ONE ask, not to its message id: the plan gate
# re-uses one id for the whole session, so a re-ask after a plan correction used to arrive "Answered" and disabled. It also keeps only the
# NEWEST approval gate (plan, outline, retry research) of a session enabled (Director re-sends the outline gate under a new id on every
# reconnect while unapproved), and enables none while a build is running, paused, stopped or the session is over (an earlier step).
# Unset or anything else keeps today's behaviour. Independent of the history flag above; works with it on or off.
NEXT_PUBLIC_STUDIO_ASK_CARD_IDENTITY_ENABLED="false"

# PASS2-DIRECTOR-CHAT PR C, header (Studio shell). Exact "true" enables it; default off, and then the Director header reads exactly as
# before ("Connected", "Connecting…", "Disconnected", "Connection error", right-aligned).
# - The connection becomes a quiet line under "Director", in plain words, from the connection state and reconnect status the chat
#   already tracks: "Connected" (socket open), "Connecting…", "Reconnecting…" (a retry is scheduled), "Offline, will retry"
#   (the browser is offline, retries resume when it is back), "Couldn't reconnect" (retries used up), else "Disconnected" or
#   "Connection error". "Loading conversation…" is unchanged. Words and layout only: no state, timer, request or send changes.
NEXT_PUBLIC_STUDIO_CHAT_HEADER="false"

# PASS2-DIRECTOR-CHAT PR C, ask card (Studio shell). Exact "true" enables it; default off, and then the ask card is exactly as before.
# - The plan gate ("Does this structure work for you?") is headed "Approval needed" instead of "Your input", as the accepted v4
#   mockup heads an approval. The outline gate keeps "Review your outline"; the questions card keeps "Quick questions", its
#   "N of M answered" count and "Send answers (k/N)". Heading words and icon only: the actions and what they send are unchanged.
NEXT_PUBLIC_STUDIO_CHAT_ASK="false"

# PASS2 #4: outline review on the canvas (Studio shell). Exact "true" enables it; default off, and then the outline, the
# chat and the history render exactly as before.
# - While Director's outline approval gate is live, the canvas shows the outline (the accepted v4 mockup's view: the slides
#   in order, one selected, "Approve & build"). The button presses the gate's own approve action through the same handler
#   as the chat card's "Looks perfect!" (same action, id and answer key; no new message type). The chat keeps the approval
#   card and a short outline summary with the slide details folded: every outline card the canvas shows (including the copy
#   kept when Director re-sends a pending outline on reconnect), and any older, different outline, marked "Earlier outline".
# - A built deck's structure that Director re-sends on reconnect is no longer drawn as a new outline card below
#   "Your presentation is ready" after a reload; the original outline card keeps its place.
# - An outline card's count reads "Outline · 7 slides", with "The deck now has N slides." when the deck has since changed.
NEXT_PUBLIC_STUDIO_OUTLINE_CANVAS="false"

# PASS2-DIRECTOR-CHAT PR B: the Director chat in the accepted v4 mockup's voice (Studio shell). Exact "true" enables it; default
# off, and then the chat is exactly as before.
# - Speaker labels: no avatar circles; a small uppercase "DIRECTOR" with the spark, "YOU" above your own turn, which sits in a soft
#   tinted block, left-aligned.
# - Type scale: Director's words at 13px on a 1.55 line with easier list spacing and a readable maximum width.
# - Thinking / status row: pulsing dots and one muted line instead of the purple box (still a status region, same text, same
#   collapsible).
# Presentation only: no message, handler, key, request or WebSocket payload changes.
NEXT_PUBLIC_STUDIO_CHAT_POLISH="false"

# PASS2-DIRECTOR-CHAT PR D, composer context (Studio shell). Exact "true" enables it; default off, and then the composer is exactly as before.
# - A line above the composer says what a message will be about, as the v4 mockup's composer does: "Working on slide 3" (the slide on the
#   canvas) while a deck is open, "New presentation" before there is one.
# - The Template and Theme selections that already sit above the message box become compact teal pills with the name in bold. They are the
#   same rows with the same clear buttons; only the look changes.
# Presentation only: no state, effect, request or WebSocket payload changes (the page hands the composer two values it already holds).
NEXT_PUBLIC_STUDIO_CHAT_COMPOSER_CONTEXT="false"

# PASS2-DIRECTOR-CHAT PR D, recovery card (Studio shell). Exact "true" enables it; default off, and then the chat is exactly as before.
# - When something interrupts Director, a calm card at the end of the conversation says so and that the slides are safe: "Your last message
#   didn't go through" (the connection expired and Director discarded it), "You're offline" (retries resume when the browser is back),
#   "Director couldn't reconnect" (retries used up), "Something interrupted Director" (Director reported an error).
# - The card has no button and sends nothing. The way out is the one that already exists: type in the message box (sending while
#   disconnected reconnects first). The notice above the conversation is unchanged.
NEXT_PUBLIC_STUDIO_CHAT_RECOVERY="false"

# MULTITAB J1 P1b: a second tab on the same session disconnected both tabs. Director keeps ONE live socket per session and closes the older
# one with code 4000 "New connection opened"; Studio treated that like a network drop and reconnected on its 1.5/3/6/12 s ladder, so the two
# tabs evicted each other about nine times in 45 s (each reconnect also re-sent set_theme) until one gave up, with no word of why. Exact "true"
# enables the fix; default off, and then every close is handled exactly as before. On (newest tab wins, as Director already does): a close
# with code 4000 AND that exact reason (Studio's own 4000 heartbeat closes carry other reasons) puts the tab in a paused state with NO
# reconnect (no timer, no ping, no frame). The tab says so: the Director header reads "Open in another tab" (NEXT_PUBLIC_STUDIO_CHAT_HEADER),
# a notice says "This session is open in another tab. Changes there are live; this tab is paused." with a "Use here" button (the existing
# explicit connect(): this tab takes the session and the other tab is the one paused), a send shows the notice instead of silently
# reconnecting, and Add Slide / Add Element / Theme / Template are disabled with the same hint; browsing the deck stays possible.
# Studio only: no Director change, no new frame, nothing is sent, saved or cached differently. Pairs with NEXT_PUBLIC_STUDIO_THEME_RESTORE
# (a takeover then adopts the stored theme instead of overwriting it with Auto) and NEXT_PUBLIC_STUDIO_DECK_CHANGED_NOTICE (a paused tab
# still hears about deck changes: that notice does not use the Director socket).
NEXT_PUBLIC_STUDIO_ONE_LIVE_TAB="false"

# PASS2-DIRECTOR-CHAT PR D, answered choice (Studio shell). Exact "true" enables it; default off, and then answered cards are exactly as before.
# - An answered ask shows which option you chose, as the v4 mockup does: a check on the button you clicked, or on the question-card
#   answers you picked. Read from your own reply already in the conversation (the button label, or "Answers: A · B · C"), so it also
#   shows after a reload. A typed reply, a repeated label or a free-text answer marks nothing.
# Presentation only: whether a card is answered or live, and everything sent, are unchanged.
NEXT_PUBLIC_STUDIO_CHAT_ANSWERED_CHOICE="false"

# R6: "Box padding" for an Add Element text box. The Format inspector opens an editable text box on its Content tab and keeps
# Box (padding, fill, border) at the bottom of the Appearance tab, in a hidden panel, below Typography, Alignment and Theme
# colors. Exact "true" gives that text box its own "Box" tab (Content | Appearance | Box | Arrange) and the header reads
# "Selected text box". Same Box controls, same commands, no new backend call. Default off, and then the inspector is exactly
# as before. A text box Layout reports as a retained custom render (graphic box) is unchanged: its Box controls stay disabled.
NEXT_PUBLIC_STUDIO_TEXTBOX_PADDING_REACHABLE_ENABLED="false"

# ================================
# File Upload Feature Configuration
# ================================

# Feature Flag - Set to 'false' to disable file uploads entirely
NEXT_PUBLIC_ENABLE_FILE_UPLOADS="true"

# Early Session Creation - Set to 'true' to enable uploading files before first message
# When enabled, clicking "Attach Files" creates a draft session immediately
# Draft sessions are deleted after 24h if no message is sent
NEXT_PUBLIC_ENABLE_EARLY_SESSION_CREATION="false"

# File Upload Limits
NEXT_PUBLIC_MAX_FILE_SIZE="20971520"  # 20 MB in bytes
NEXT_PUBLIC_MAX_FILES="5"

# Supported File Types (comma-separated extensions)
NEXT_PUBLIC_ALLOWED_FILE_TYPES=".pdf,.docx,.doc,.txt,.md,.xlsx,.xls,.csv,.pptx,.ppt,.json,.xml,.yaml,.yml,.png,.jpg,.jpeg,.py,.js,.ts,.java,.go,.rs"

# Researcher ingest-status poll carries an owner-bound session token (J6-INGEST-STATUS-AUTH-FE).
# The Researcher flag RESEARCHER_INGEST_STATUS_AUTH_ENABLED (MR !235) makes the upload's job-status poll
# answer 401 unless the request has a signed X-Deckster-Session-Token. Exact "true" here sends the poll
# through the same-origin route /api/researcher/ingest-status/{jobId}, which checks the signed-in user owns
# the chat session, signs a 2-minute token for the Researcher session saved on it, and forwards the poll
# with the header. The token never reaches the browser. Anything else (default): the direct, credential-less
# poll it has always been. Needs PK's go-ahead and RESEARCHER_SESSION_TOKEN_SECRET set on the server first
# (otherwise the route answers 503 and sends nothing). Safe to turn on before the Researcher flag (the
# Researcher ignores the header while its flag is off); it must be on before the Researcher flag is.
# Client-visible by design.
NEXT_PUBLIC_RESEARCHER_INGEST_STATUS_AUTH_ENABLED="false"
# Server-only signing secret: the same value the Researcher uses in that environment, at least 32 bytes
# (a shorter value counts as not set). Never a NEXT_PUBLIC_ variable. Generate it independently,
# for example: openssl rand -base64 48
RESEARCHER_SESSION_TOKEN_SECRET=""

# ================================
# Session Cleanup Configuration
# ================================

# Secret for authenticating cron job requests
# Generate with: openssl rand -base64 32
# Required for: /api/admin/cleanup-sessions endpoint
CRON_SECRET="your-random-secret-here-use-openssl-rand-base64-32"

# Session abandonment threshold (in hours)
# Draft sessions older than this with no messages will be deleted
# Default: 24 hours
SESSION_CLEANUP_THRESHOLD_HOURS="24"

# ================================
# Google Cloud / Vertex AI Configuration
# ================================

# Google Cloud Project Configuration
# Get these from: https://console.cloud.google.com/
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"  # or your preferred region (e.g., us-east4, europe-west1)

# Service Account Authentication (Choose ONE method)
# Download service account from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Required IAM roles: "Vertex AI User", "Storage Object Admin"

# Method 1 (RECOMMENDED for Production/Vercel): Base64-encoded service account JSON
# Generate with: base64 -i service-account-key.json
# Copy the output and paste it here (single line, no spaces)
# GOOGLE_APPLICATION_CREDENTIALS_BASE64="ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsIC4uLiB9Cg=="

# Method 2 (Local Development): File path to service account JSON
GOOGLE_APPLICATION_CREDENTIALS="./service-account-key.json"

# Method 3 (Not Recommended): Inline JSON (requires careful escaping)
# GOOGLE_APPLICATION_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Gemini Model Configuration
GEMINI_MODEL="gemini-2.5-flash"  # or gemini-pro, gemini-ultra

# ================================
# Gemini Developer API (File Search)
# ================================

# Gemini API Key (REQUIRED for File Search / File Uploads)
# Get your API key from: https://aistudio.google.com/app/apikey
# NOTE: File Search Stores are only available via Gemini Developer API, NOT Vertex AI
# This is separate from your Google Cloud service account credentials above
GEMINI_API_KEY="your-gemini-api-key-here"

# Backend Content Generation Service (NEW ARCHITECTURE)
# Backend now only handles content generation, not file uploads
BACKEND_CONTENT_SERVICE_URL="http://localhost:8000"
# Production: https://deckster-content-service.up.railway.app

# ================================
# Stripe Payment Integration
# ================================

# Stripe API Keys
# Test mode: https://dashboard.stripe.com/test/apikeys
# Live mode: https://dashboard.stripe.com/apikeys
# WARNING: Never commit actual keys to version control!
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"

# Stripe Webhook Secret
# Test mode: https://dashboard.stripe.com/test/webhooks
# For local development: Run 'stripe listen --forward-to http://localhost:3002/api/webhooks/stripe'
# The CLI will display the webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Stripe Product Price IDs
# Create products at: https://dashboard.stripe.com/test/products
# Pro Plan - Monthly: $29.00 USD / month
# Pro Plan - Yearly: $290.00 USD / year (20% savings = $58)
STRIPE_PRO_MONTHLY_PRICE_ID="price_your_monthly_price_id"
STRIPE_PRO_YEARLY_PRICE_ID="price_your_yearly_price_id"

# Note: NEXT_PUBLIC_APP_URL is already defined above and will be reused for Stripe redirects

# Sign-in and sign-up legal links (CA-J1F10). "true" points Terms and Privacy at
# /legal/terms and /legal/privacy. Unset or anything else keeps /terms and /privacy.
NEXT_PUBLIC_LEGAL_LINKS_FIXED_ENABLED="false"

# Studio deck list cards (PASS2 #10). Exact "true" enables it; default off.
# On: a deck card shows one plain status word (Complete / In progress / Outline preview) instead of the internal
# "Stage 4: Preview Ready" badge, and drops a description that only repeats the title. It uses only fields the sessions
# API already returns (no views, Q&A or publish state). Off: the card is unchanged.
NEXT_PUBLIC_STUDIO_DECK_CARDS_V2="false"

# PASS2D R5: a deck card on the Decks page no longer says "3 slides" over a thumbnail that says "1 / 1". The card's count is the session row's slideCount: for a finished deck it is the deck's own
# count, for a deck still in progress it is the OUTLINE's count; and the card previewed the final deck first, which for a row the build before NEXT_PUBLIC_STUDIO_BLANK_DECK_RELOAD_FIX had saved was the blank
# one-slide deck. On: an unfinished deck that has a strawman previews the strawman (the deck its count describes); a finished deck says "30 slides" ("1 slide"), an unfinished one says "3 slides planned",
# one with no count yet says "No slides yet". The count itself, the status pill and every request are unchanged. Exact "true" enables it; default off. READ AT BUILD TIME: set it on Vercel, then redeploy.
NEXT_PUBLIC_STUDIO_DECK_CARD_SLIDE_COUNT="false"

# Studio Add Element picker as a card gallery (PASS2 #6). Exact "true" enables it; default off.
# On (normal Studio viewer only, not fullscreen): the Add Element menu is a grid of illustrated cards, one per element type, in the
# accepted mockup's order, each with the name and a one-line description. Same element types, same handlers and the same follow-on
# generation panel as the plain dropdown; only the picker's presentation changes. Off: the dropdown is unchanged.
NEXT_PUBLIC_STUDIO_ELEMENT_GALLERY="false"

# PASS2D B3a: the Add Element card gallery stays whole at narrow widths. Exact "true" enables it; default off. READ AT BUILD TIME: set it on Vercel, then redeploy.
# Needs NEXT_PUBLIC_STUDIO_ELEMENT_GALLERY on (it only changes that gallery). Off: the gallery is exactly what it was.
# On: the gallery is sized from the room the menu really has (never past the viewport, a 12 px margin to the left and right edges), and at 480 px and below it keeps
# three compact columns (names only; the one-line description stays as the accessible description), so all nine cards fit a 420 px wide, 560 px tall viewport.
# Before: at 480 px and below it was two columns about 600 px tall, so Table, Diagram, Infographic, Icon / Label and Shape sat below the fold of a thin-scrollbar list.
NEXT_PUBLIC_STUDIO_ELEMENT_GALLERY_FIT="false"

# PASS2-J3 P1: choosing an Add Element card must not leave an empty placeholder in the deck. Exact "true" enables it (Studio shell only,
# NEXT_PUBLIC_STUDIO_V4_SHELL); default off, and then the Add Element flow is exactly as before. READ AT BUILD TIME: set it on Vercel, then redeploy.
# Off: choosing a card inserts a placeholder box on the slide at once; cancelling the form leaves it, and Layout has saved it into the deck.
# On: choosing a card puts nothing on the slide (the form opens as before). Generate then inserts the placeholder just before it first needs it
# (the same Layout command with the same parameters), shows its progress overlay, and replaces it with the generated element. A Generate that
# ends without the generated element (a refusal, a failure) takes the empty placeholder out again, so an empty element exists on the slide only
# while a Generate is in flight; the form keeps its draft and Retry inserts it afresh. Cancelling or switching card creates and deletes nothing.
# Placeholders already saved in a deck are real elements and are not touched.
NEXT_PUBLIC_STUDIO_ELEMENT_PLACEHOLDER_FIX="false"

# PASS2D (Pass 2 close-out, ELEMENT-2 row 10): a new Add Element box must not land on top of the elements already on the slide. Exact "true"
# enables it (Studio shell only, NEXT_PUBLIC_STUDIO_V4_SHELL); default off, and then every new element is placed at column 2, row 4 as before.
# READ AT BUILD TIME: set it on Vercel, then redeploy.
# On: choosing an Add Element card first reads the slide's elements from the viewer (the `getSlideGenerationContext` message Generate already
# uses) and puts the new element in the first free spot of the content area (columns 2-32, rows 4-18), reading left to right and then top to
# bottom, with one grid unit of space around it when there is room. No room, an unreadable answer, no answer within 2 seconds, or a slide or
# deck that changed meanwhile: column 2, row 4, as before. Only the elements the viewer lists are avoided: the body of an L-series slide
# (raw rich content) is not an element and is not avoided. Full-bleed backdrop images (90% of the canvas or more) and hidden elements are ignored.
NEXT_PUBLIC_STUDIO_ELEMENT_FREE_SPOT="false"

# Studio composer popups (PASS2-COMPOSER-POPUPS). Exact "true" enables it (Studio shell only); default off.
# On: (1) the composer's typed text and placeholder are about 15% smaller; (2) the Build theme popup shows two searchable dropdowns,
# "Deckster themes" (Auto + presets) and "My themes" (saved), above the unchanged Brand color row, "Save or set standard..." and "Manage themes";
# (3) only one composer popup (template, theme, research) is open at a time, and Escape or a click outside closes it; (4) the template popup
# shows "Deckster templates" and "My templates" dropdowns, then "Template library" and "New template..."; (5) in a narrow window the pane
# strip reads Slides / Director / Edit with icons and a tooltip, and Edit is hidden until something is selected. Same handlers and payloads
# for every action; nothing about sending changes. Off: the composer, both popups and the strip are unchanged.
# Fix-forward (same flag): with the composer library on (NEXT_PUBLIC_COMPOSER_LIBRARY_ENABLED), "My templates" lists the library's own
# templates (the library dialog's request) with the dialog's actions (Use original, plus Rebuild from own content and New topic behind their
# own flags), which the library dialog runs with its own handlers; "Template library" opens that dialog, and /studio/templates is linked only
# where it works (NEXT_PUBLIC_TEMPLATE_BUILDER_ENABLED); an empty list says why in plain words.
NEXT_PUBLIC_STUDIO_COMPOSER_POPUPS_V2="false"

# J7-PASS2-FIXES item 1 (DEADLINE 16 Oct 2026): Intelligence > Design preview model catalog. Exact "true" enables it; default off, and then the
# 2026-08-20.1 catalog and the page are exactly as before. Needs the Studio shell (NEXT_PUBLIC_STUDIO_V4_SHELL). READ AT BUILD TIME: set it on
# Vercel, then redeploy. On: snapshot 2026-10-13.1 drops Gemini 2.5 Flash, Flash Lite and Pro (retiring 16 Oct) and lists their successors
# (3 Flash Preview, 3.1 Flash Lite, 3.1 Pro Preview); the comparison also shows release status (Preview / GA), price per 1M tokens,
# structured output and input types. A retired id in a draft maps to its successor. 2.5 Flash Image is not on the retirement list and stays.
# Static catalog: no request, no model call, nothing saved.
NEXT_PUBLIC_STUDIO_MODEL_CATALOG_2026_10="false"

# J7-PASS2-FIXES items 2 and 3: Intelligence > Design preview polish. Exact "true" enables it; default off, and then the page is byte-for-byte
# unchanged. Independent of NEXT_PUBLIC_STUDIO_MODEL_CATALOG_2026_10 (either, both or neither). Needs the Studio shell (NEXT_PUBLIC_STUDIO_V4_SHELL).
# READ AT BUILD TIME: set it on Vercel, then redeploy. On: (2) the Design-preview draft is kept per browser in localStorage (key versioned with the
# catalog version, never the account) and restored on reload together with the Design-preview view, through the catalog's retired-model mapping;
# Reset draft clears it; if the browser has no usable storage the draft is session-only, the page says so and warns before leaving. (3) the page gains
# the Reusable defaults / This presentation toggle (This presentation is disabled: it has no backing here), the "Your own intelligence" readiness
# popup, a "Managed by Deckster" section and one status pill, and the repeated "not connected" disclaimers become one note. No request is made,
# nothing is sent to a model, nothing is saved to the account.
NEXT_PUBLIC_STUDIO_INTELLIGENCE_POLISH="false"

# PASS2-J3 P0 (items 5 and 6): Add Element and theme picks on a NEW blank-canvas session. Exact "true" enables it; default off,
# and then the Director socket hook is exactly as before. Only acts with the composer library on (NEXT_PUBLIC_COMPOSER_LIBRARY_ENABLED).
# Director answers a new session with its blank deck (presentation_init) and never a sync_response, so the composer theme policy
# stayed unresolved: "Waiting for the presentation theme policy from Director", Apply theme disabled, Text Labs never called.
# On: the session's first blank deck frame on a socket that has had no sync_response resolves the policy as "no adoption", so the
# normal set_theme / element theme preflight runs. A Composer adoption (Use original result, cached marker or sync) stays frozen,
# and a reconnect still waits for Director's sync_response. No new frame type or payload field (the set_theme that was refused is
# now sent as before), and nothing new is saved: the resolution is per socket and never cached.
NEXT_PUBLIC_STUDIO_NEW_SESSION_THEME_POLICY="false"

# J6 pass-2 fixes for the Second Brain (Knowledge) page (card PASS2-J6-FINDINGS). Exact "true" enables them; default off, and then the page is
# exactly as before. READ AT BUILD TIME: set it on Vercel, then redeploy. Works with or without the Studio shell. On: (1) a stats or graph
# response that lacks nodes_by_type, top_entities, nodes or edges is treated as empty instead of crashing the page, and each section (summary,
# type filters, map, inspector) plus the whole page sits in an error boundary that shows a plain notice with "Try again"; (2) the browser's
# "Failed to fetch" and the backend's own error text are replaced by a plain sentence ("You seem to be offline...", "The import could not be
# completed...") with a Retry in the load error, the search results, the entity inspector and the failed-import banner; the technical detail
# goes to the browser console only; (3) an import that was running when the page was reloaded (or runs in another tab) is announced on
# return ("An import may still be running..."), from a per-browser localStorage marker (hashed account tag, no identity) that the import
# writes when it starts, refreshes after each batch and removes when it finishes; there is no import-status endpoint, so nothing is asked of
# the server; (4) "Import past sessions" (which writes entities, relations and evidence into the person's real, saved graph; UAT and Studio dev
# share the production data) no longer starts on one click: every way to start it (the header button, the empty-map button, the failed-import
# Retry) opens a confirm dialog that names what is written, and the import starts only from its "Import sessions" button; Cancel, Escape and a
# click outside close it without a request, and it warns when another import may still be running; (5) singular copy where a count is 1
# ("1 new entity", "1 needs another attempt", "1 was already in your graph", "1 entity", "1 relation", "1 session").
# No new requests, no backend change.
NEXT_PUBLIC_STUDIO_KNOWLEDGE_FIXES="false"

# Composer library: an orphaned job no longer locks the library dialog (P2 from COMPOSER-2). Exact "true" enables it; default off, and then
# the dialog is exactly as before. READ AT BUILD TIME: set it on Vercel, then redeploy. Works with or without the Studio shell; acts only with
# the composer library on (NEXT_PUBLIC_COMPOSER_LIBRARY_ENABLED). The dialog keeps the job it is waiting for in sessionStorage
# (deckster_composer_job_<user>) and resumes it on opening; a job whose Director process died stayed "assembling" for ever, so the dialog
# showed "Creating deck: assembling…" and every action (Use original, Rebuild, New topic, Upload) stayed disabled. On: a job Director reports
# failed (or cancelled), or an unfinished job whose record (updated_at) is more than 75 minutes old (Director's 60-minute worker deadline
# plus one 15-minute request window; no live job goes that long without a write), ends the wait as a plain notice in place of the progress
# line, and every other action works again. Retry runs the same action again through the dialog's own handler (a new session and job, as
# its button would; an upload only while its file is still chosen); Dismiss removes that one stored record in this tab. Nothing on the server
# is changed or deleted; a job still moving is waited for exactly as before. The stored record also keeps the action that started the job
# (a template's id and name, or a new topic's brief) so Retry works after a reload. A Director with its orphan watchdog on
# (COMPOSER_STALE_JOB_WATCHDOG_ENABLED) fails such a job itself within minutes, as failed with "retryable": true; the dialog then shows that
# text with Retry and Dismiss. The 75-minute rule is the fallback for a Director without the watchdog.
NEXT_PUBLIC_STUDIO_COMPOSER_JOB_RECOVERY="false"

# Template "wow" flow, Studio half (FRONTEND, 15 Oct 2026). Exact "true" enables it; default off, and then the Template library is exactly as before.
# READ AT BUILD TIME: set it on Vercel, then redeploy. Works with or without the Studio shell; acts only with the composer library on
# (NEXT_PUBLIC_COMPOSER_LIBRARY_ENABLED). Needs Director's COMPOSER_TEMPLATE_PROGRESS_ENABLED (which needs Composer's own) for the full flow: Director then
# adds template_progress, capabilities and poll to GET /api/template-ingest/stage/jobs/{job_id} (streams/composer/TEMPLATE-PROGRESS-CONTRACT.md 2.2). On, an
# uploaded template is read in the background (the dialog is not busy while it runs) at poll.next_interval_ms, stopping when poll is null; the library
# shows a card with the stage in words, slides done of slide count, the time left, one dot per slide (a slide kept as-is is a neutral dot) and what is
# ready. "Use original" opens as soon as capabilities.use_original is available and template_progress.as_is.ready (toast "Ready to use as-is", once per
# job); "New topic" follows capabilities.new_topic.state alone (an unlockable / kept-as-is slide never blocks it: PK 13 Oct; toast "Template ready for new
# topics", once per job), with plain words for unavailable / refused and Director's own locking.message for a paused or failed lock. A job that failed or
# is stalled (poll.stalled, 120 s without a heartbeat: "Still working…" with Retry and Dismiss) never blocks a new upload. A failed upload, or a lock that
# failed and Director calls retryable, keeps the Retry of NEXT_PUBLIC_STUDIO_COMPOSER_JOB_RECOVERY (the dialog's own upload of the same chosen file) and Dismiss;
# a refused, paused or otherwise unavailable card gets Dismiss; Dismiss forgets the stored job. The job id is kept in
# sessionStorage (deckster_composer_template_progress_<user>) so a reload goes on reading it. Against a Director without the flow (no poll, no
# template_progress) it polls at the old 5 s and shows the old "Preparing template: <status>…" line, and holds nothing.
NEXT_PUBLIC_STUDIO_TEMPLATE_PROGRESS="false"

# Template "What changed" admission report (FRONTEND, 16 Oct 2026; depends on composer MR !99 COMPOSER_UPLOAD_ADMISSION_REPORT_ENABLED and director MR !502
# DIRECTOR_TEMPLATE_ADMISSION_REPORT_ENABLED, turned on in that order). Exact "true" enables it; default off, and off the Template library is exactly what it was.
# With it on, a template that has a stored report shows it under its row in the Template library: the headline, the changes in rank order (text left out, a
# slide rebuilt over a picture, something left out and something kept as a picture are emphasised), "and N more small changes", and a slide-by-slide strip (display
# only). A template with no report (uploaded before the flags, or with a flag off) shows nothing. Needs no other Studio flag. The strip comes from the uploading job's
# read while it is tracked (NEXT_PUBLIC_STUDIO_TEMPLATE_PROGRESS), otherwise from ONE read-only GET of the template (/api/composer-library/templates/{id}, trimmed to its
# report), made once per template when its list of changes is opened, one at a time, and dropped quietly if it fails. That route exists only with this flag on: off, the
# Composer proxy answers it 404 as before. READ AT BUILD TIME (the route and the Template library read the same value).
NEXT_PUBLIC_STUDIO_TEMPLATE_ADMISSION_REPORT="false"

# PASS2B S-fixes batch 1 (FRONTEND-2; mockup gaps G20, G12, G09). Three independent flags, Studio shell only. Exact "true" enables one; default off, and
# then the rail, the composer line and the first-run poster are exactly as before. READ AT BUILD TIME: set each on Vercel, then redeploy.
# G20 An untitled slide in the slide rail reads as its layout's friendly name ("Image + Text", "Chart", "Section Divider") instead of "Slide 7".
#     The name comes from the layout Layout's slide inventory already sends for each slide (no new request) and the layout catalogue the picker uses;
#     a slide with a title keeps it, and a layout with no catalogue entry keeps "Slide N". Needs NEXT_PUBLIC_STUDIO_RAIL_SLIDE_IDENTITY_ENABLED (the inventory).
NEXT_PUBLIC_STUDIO_RAIL_LAYOUT_LABELS="false"
# G12 The composer's context line (NEXT_PUBLIC_STUDIO_CHAT_COMPOSER_CONTEXT must also be on) names the stage until a built deck exists: "Planning your
#     deck" while Director works on the brief, "Reviewing the outline" while the outline is on the canvas, "Building slides" during the build. It no
#     longer says "New presentation" while planning or "Working on slide 1" before any slide is built. With a built deck it reads as before.
NEXT_PUBLIC_STUDIO_COMPOSER_STAGE_CONTEXT="false"
# G09 Once the first message of a session is sent, the canvas's first-run poster ("Tell Director who it's for and what you want to say") is replaced by
#     a planning card ("Your presentation will take shape here. Director is shaping your outline.") and the first-run actions under it are not offered.
NEXT_PUBLIC_STUDIO_FIRST_RUN_POSTER_HIDE="false"

# PASS2B S-fixes batch 2 (FRONTEND-2; mockup gaps G01+G02, G43+G54, G38). Three independent flags, Studio shell only. Exact "true" enables one; default
# off, and then the welcome, the navigation labels and the template pickers are exactly as before. READ AT BUILD TIME: set each on Vercel, then redeploy.
# G01+G02 The welcome's eyebrow "Your presentation brief" becomes a time-of-day greeting with the signed-in user's first name ("Good morning, Alex";
#     shown upper-case by the stylesheet). The name is the first word of the session user's display name; with none (or an email stored as the name)
#     it is "Good morning" alone, and an email is never drawn. Before 12:00 morning, before 17:00 afternoon, otherwise evening, by the browser's clock.
#     The collapsed "Slide" tab on the right edge is no longer drawn on the welcome screen or over the outline (it stays once a deck exists, on a
#     hand-made blank deck, and whenever the Slide panel is open).
NEXT_PUBLIC_STUDIO_WELCOME_POLISH="false"
# G43+G54 Plain words for the Studio navigation, as in the mockup. The left rail's "Decks" reads "Your decks" and "Knowledge" reads "Second brain" (the
#     tooltip and the accessible name), and the top bar's title on /dashboard and /knowledge says the same; the routes are unchanged. The Decks page's
#     second tab "Strawman Previews (n)" reads "Outline previews (n)", the word its stat tile already uses (Studio shell only). Labels only.
NEXT_PUBLIC_STUDIO_PLAIN_NAV_LABELS="false"
# G38 Templates are listed by a short display name instead of the stored upload name: "Deck03_Northwind_QBR.pptx — upload 2026-10-12 22:53 UTC [id]"
#     reads "Deck03 Northwind QBR" (extension, upload date and id removed, underscores become spaces; never empty). Display only, in the composer's
#     template popup, the toolbar's Template picker and the template library dialog: the full name stays in the row's tooltip, search still matches
#     it, and the ids, the selection payloads, the library's requests and the session titles are unchanged. The helper lib/studio-template-display-name.ts
#     is standalone for other dialogs to reuse.
NEXT_PUBLIC_STUDIO_TEMPLATE_DISPLAY_NAMES="false"
# G48 Quiet rows in the Sessions panel, as in the mockup (Studio shell only). A row drops its message preview when that is one of Director's canned lines
#     ("Your presentation is ready.", its greeting, "Here is the outline for your deck."); a real first prompt or reply is kept. A session with no stage yet
#     reads "Draft" instead of "Unknown". Title, slide count and time are unchanged.
NEXT_PUBLIC_STUDIO_SESSION_ROW_QUIET="false"
# G39 No empty "Deckster templates" block in the composer's template pop-up (needs NEXT_PUBLIC_STUDIO_COMPOSER_POPUPS_V2). Deckster has no ready-made catalog yet, so the
#     disabled "No Deckster templates yet" dropdown and its explanation are not drawn; "My templates" is the pop-up's first block. A catalog with entries
#     brings the block back unchanged.
NEXT_PUBLIC_STUDIO_EMPTY_CATALOG_HIDE="false"
# G56 One word for the create action (Studio shell only). The Decks page's "New Presentation" and "Create Presentation" buttons and the Sessions panel's "Presentation"
#     button say "New deck", the word the top bar (NEXT_PUBLIC_STUDIO_TOP_BAR_V2) already uses; with the top-bar flag off its button says it too. Labels only:
#     routes, handlers and every other string are unchanged.
NEXT_PUBLIC_STUDIO_CREATE_WORD="false"
# G53 Four deck cards per row on the Decks page from 1280 px up, as in the mockup (Studio shell only). Below that the grid keeps its 1, 2 and 3 columns, and the
#     list view stays one column.
NEXT_PUBLIC_STUDIO_DECK_GRID_4="false"
# G16 Export stays disabled until a deck is built (Studio shell only). While the open deck is only the outline (builder stage 4) and no final deck exists, the
#     Export button is greyed and a tooltip (also read by screen readers) says "Export unlocks once your deck is built." The base enables it there and exports the
#     outline's strawman. A built deck, a blank deck and every other stage keep the base rule. Publish already waits for the final deck.
NEXT_PUBLIC_STUDIO_EXPORT_AFTER_BUILD="false"
# G29+G33 A violet band over the header of the Add Slide and Add Element panels, as in the mockup (Studio shell only): "CREATE SLIDE" with "Insert after slide N" on
#     the right (v2 and classic slide panels; "REGENERATE SLIDE", "REFINE SLIDE" in those modes) and "CREATE ELEMENT" with "Selected Chart" (the element's name; "EDIT ELEMENT" and
#     "REFINE ELEMENT" in those modes). The panels' own title and subtitle are unchanged, and the band replaces the header's thin violet top rule.
NEXT_PUBLIC_STUDIO_PANEL_EYEBROW="false"
# G35 An "Open themes & brand kit" link at the foot of the deck theme picker (Studio shell only), as in the mockup. It opens /studio/themes (same tab, closing the
#     picker, as the template pop-up's "Template library" link does) and shows whether the deck's theme is locked or not. Nothing else in the picker changes.
NEXT_PUBLIC_STUDIO_THEME_BRAND_LINK="false"
# G42 Plain words for the Templates page notice shown while saved templates are off (NEXT_PUBLIC_TEMPLATE_BUILDER_ENABLED unset; Studio shell only): "Saved templates are not
#     available yet. You can still sketch a draft here and continue planning it in Studio." replaces "...not enabled in this environment ... when enabled". The words are
#     one constant in lib/studio-templates-notice.ts for PK to change; the notice still shows under the same condition.
NEXT_PUBLIC_STUDIO_TEMPLATES_NOTICE_PLAIN="false"

# PASS2B chat touches (E2E-2, card PASS2B-JOURNEY-ELEVATION, audit rows J1-10, J1-15, J1-17, J1-02, J1-07). Five independent flags, Studio shell only.
# Exact "true" enables one; default off, and then the chat, composer and build ribbon are exactly as before. READ AT BUILD TIME: set it on Vercel,
# then redeploy. All five are presentation only: no change to the WebSocket hook, reducer, cache, history restore, React keys, handlers or any
# send payload (scripts/test-studio-pass2b-chat.mjs and the recorded-transcript harness prove flag off is byte-identical and flag on differs only
# by what each flag adds).
# J1-10 After "I'd like to make changes" (plan gate) or "Make some changes" (outline gate) the composer is focused once and its placeholder reads
#       "Tell Director what to change…" until the next message. Derived from the transcript: the last user turn is the click on that action.
NEXT_PUBLIC_STUDIO_CHAT_EDIT_PROMPT="false"
# J1-15 A build that failed no longer offers Pause and Stop (nothing is running); the build ribbon says "Your outline and any finished slides are
#       saved. Send a message to try again." under the error words.
NEXT_PUBLIC_STUDIO_BUILD_ERROR_STATE="false"
# J1-17 A Director error notice (the card above the conversation, and the calm recovery card when NEXT_PUBLIC_STUDIO_CHAT_RECOVERY is on) stops
#       being drawn once you have sent another message and Director has answered. Derived at render from the user-turn and Director-message
#       counts when the notice was first seen; a retry that fails again raises a new notice, which is shown. Nothing is dismissed or cleared in the hook.
NEXT_PUBLIC_STUDIO_CHAT_ERROR_CLEAR="false"
# J1-02 When every bounded reconnect attempt is used up (header "Couldn't reconnect" / "Disconnected"), a small "Reconnect" button in the Director
#       header calls the page's existing connect(): the same explicit reconnect that sending a message while disconnected, or "Use here" for a
#       paused tab, already does. It sends nothing.
NEXT_PUBLIC_STUDIO_CHAT_RECONNECT="false"
# J1-07 The plan and outline approval cards say, under the buttons, "About 3–5 minutes. You can stop anytime." (builds in the J1 runs took
#       3 min 20 s to 4 min 52 s; Stop is on the build ribbon).
NEXT_PUBLIC_STUDIO_APPROVAL_HINT="false"

# PASS2B G11 (FRONTEND-2): the Studio chat column's DEFAULT width follows the accepted v4 mockup. Exact "true" enables it; default off, and then the
# column is exactly as before (304 px, or the welcome width, unless you dragged it). READ AT BUILD TIME: set it on Vercel, then redeploy.
# On, in the side-by-side layout (1100 px workspace and wider): 560 px while a deck does not exist yet (plan gate, outline review, build), 440 px
# once a deck is open, never taking the canvas below 640 px (plan, outline) or 720 px (deck), so a narrower window degrades toward 304 px. The
# welcome / brief width, a width you dragged (it always wins), the 480 px canvas floor, the 360 px cap beside an inspector, the narrow
# single-pane / overlay layouts and the panel-focus collapse are not touched. Presentation only; Studio shell only.
NEXT_PUBLIC_STUDIO_CHAT_WIDTH_V2="false"

# PASS2B G21 (FRONTEND-2): a "+ Add slide" button in the footer of the Studio slide rail, as in the accepted v4 mockup (Studio shell only). Exact "true" enables it;
# default off, and then the rail is exactly as before. READ AT BUILD TIME: set it on Vercel, then redeploy. The button OPENS the existing Add Slide panel through
# the toolbar button's own handler (it needs NEXT_PUBLIC_STUDIO_ADD_SLIDE_V2_ENABLED; without the panel it is not drawn) and sends no Layout or viewer command
# itself: only the panel's Generate / Blank slide ever do, exactly as when the toolbar opened it. It is greyed exactly when the toolbar's Add Slide is (no deck
# loaded or loading, Template Mode, a slide change in flight, a tab paused by NEXT_PUBLIC_STUDIO_ONE_LIVE_TAB, or a build running), with the same words
# when NEXT_PUBLIC_STUDIO_DISABLED_REASONS is on.
NEXT_PUBLIC_STUDIO_RAIL_ADD_SLIDE="false"

# PASS2B G45 (FRONTEND-2): "<- Back to Studio" at the right of the Studio top bar on the library pages, as in the accepted v4 mockup (Studio shell only). Exact "true"
# enables it; default off, and then the top bar is exactly as before. READ AT BUILD TIME: set it on Vercel, then redeploy. Pages: Decks, Knowledge, Templates,
# Themes & brand, Intelligence and Your details (/dashboard, /knowledge, /studio/templates, /studio/themes, /studio/intelligence, /studio/details, /profile);
# settings, billing and the rest keep the plain bar. It is the existing return button, so it goes to the last builder session this browser remembers for the
# account, else to a fresh /builder, exactly as the rail's Studio icon does. The pages' own "Back to Studio" buttons stay where they are.
NEXT_PUBLIC_STUDIO_LIBRARY_BACK_LINK="false"

# PASS2D A1 (FRONTEND-1): the unsent text in the chat composer survives a reload (PASS2-J1-FINDINGS item 4). Exact "true" enables it; default off, and then
# the composer is exactly as before. READ AT BUILD TIME: set it on Vercel, then redeploy. On: the text is kept in sessionStorage per account + session as you type
# (blank removes it) and goes back into an EMPTY box on load, or when a fresh session first gets its id; a box that already has text is never overwritten.
# Moving to another existing session shows that session's own draft, or an empty box. A completed send clears the box and with it the stored draft; a failed
# send leaves the text in the box, so it stays stored too. Capped at 20,000 characters; a blocked or full storage never throws. Works in the classic and the
# Studio builder. It sends nothing and calls no service.
NEXT_PUBLIC_STUDIO_COMPOSER_DRAFT="false"

# PASS2D A3 (FRONTEND-1): the canvas Theme dialog says what a theme does on a blank canvas (ELEMENT-2 item 6, PASS2-J4-FINDINGS item 3). Exact "true" enables it; default
# off, and then the dialog is exactly as before. READ AT BUILD TIME: set it on Vercel, then redeploy. On, only while the deck is the blank canvas (the viewer's
# isBlankPresentation) and the choice is open (not locked): a short note under the dialog's header ("A blank canvas doesn't change when you apply a theme. Director uses it
# when it builds your slides."), and the preview's closing line reads "A preview only: your slides use this theme when Director builds them." in place of "your deck changes
# when you apply the theme". It is words only: "Apply theme" still turns on when the picked theme differs from the applied one and off once it is applied, and the payload
# is the same. Needs the lighter picker (NEXT_PUBLIC_STUDIO_THEME_PICKER_V2 or NEXT_PUBLIC_STUDIO_THEME_DROPDOWN, the preview line needs the dropdown); the plain panel is
# untouched, and so is the page-level panel before a deck exists.
NEXT_PUBLIC_STUDIO_THEME_BLANK_NOTE="false"

# PASS2D B4: after a slide is deleted the canvas stops showing it. Exact "true" enables it (Studio shell only); default off. READ AT BUILD TIME: set it on Vercel, then redeploy.
# Layout's deleteSlides command deletes on the server, calls window.location.reload() and replies at once. Studio updates its count, rail and toast, but the iframe keeps showing
# the old document (the deleted slide included, still editable, with its own old "2 / 11" counter) until the reloaded one paints: 14-20 s on the UAT Layout.
# On: when the delete is acknowledged and no new frame has loaded since the command was sent, the canvas is covered by "Updating your slides…" until the reloaded frame has
# loaded (or 45 s pass, whichever is first). Off: exactly as before.
NEXT_PUBLIC_STUDIO_SLIDE_DELETE_CANVAS_REFRESH="false"

# SLIDE-OPS-VIA-VIEWER (needs Layout MR !239, LAYOUT_AUTOSAVE_FLUSH_WHILE_SAVING_ENABLED): an edit still pending when a slide is deleted, duplicated or re-laid-out must reach the server
# BEFORE the change. Exact "true" enables it; default off. READ AT BUILD TIME: set it on Vercel, then redeploy.
# On: the slide panel's Duplicate, Delete and Layout buttons send the viewer's own commands (duplicateSlide, deleteSlides, changeSlideLayout; the ones the slide rail uses) instead of calling
# Layout's REST endpoints from the page, so Layout saves what is pending first (and the viewer reloads itself); a delete takes the same canvas veil as the rail's
# (NEXT_PUBLIC_STUDIO_SLIDE_DELETE_CANVAS_REFRESH). And the Version History panel's Restore first makes sure nothing is pending (viewer forceSave, then the viewer's own "saved, nothing
# pending" message) and does not send the restore if that cannot be shown (the Version History panel is not opened from anywhere in Studio today, so this part is inert until it is). Off: exactly as before.
NEXT_PUBLIC_STUDIO_SLIDE_OPS_VIA_VIEWER="false"

# IMAGE-PENDING-WRITE (needs Layout MR !240, LAYOUT_IMAGE_GHOST_ONLY_WHEN_PENDING_ENABLED; contract v1 in streams/slide/RESULT-B3B-GHOST.md): the empty hero background shows its
# "Generating image…" ghost only while a stored field says an image job is pending, and whoever starts the job writes it. Exact "true" enables it; default off. READ AT BUILD TIME:
# set it on Vercel, then redeploy. On: an IMAGE generated into a hero's background slot stores `image_status: "pending"` + `image_job_id` in that slide's content (Layout's batch
# PUT /api/presentations/{id}/slides, after the viewer reports its own save) as the request goes out, and "ready" or "failed" with the same job id when the job ends. Any other
# image job writes nothing. Off: exactly as before (no request to Layout, no listener).
NEXT_PUBLIC_STUDIO_IMAGE_PENDING_WRITE="false"
