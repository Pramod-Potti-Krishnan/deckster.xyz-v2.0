// This is your Prisma schema file for Supabase PostgreSQL
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?

  // Subscription tier
  tier          String    @default("free")

  // CRITICAL: Manual approval system
  approved      Boolean   @default(false)
  approvedAt    DateTime? @map("approved_at")
  approvedBy    String?   @map("approved_by")

  // Stripe Integration Fields
  stripeCustomerId       String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map("stripe_subscription_id")
  stripePriceId          String?   @map("stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map("stripe_current_period_end")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Wallet
  walletBalanceCents Int @default(0) @map("wallet_balance_cents")

  accounts           Account[]
  sessions           Session[]
  chatSessions       ChatSession[]
  uploadedFiles      UploadedFile[]
  subscriptions      Subscription[]
  preferences        UserPreferences?
  couponRedemptions  CouponRedemption[]
  walletTransactions WalletTransaction[]
  publishedDecks     PublishedDeck[]

  @@map("auth_users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

// Chat Session Management Models
// Stores metadata for each presentation generation session
model ChatSession {
  id                     String    @id                    // WebSocket session_id (UUID)
  userId                 String    @map("user_id")

  // Session metadata
  title                  String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  lastMessageAt          DateTime? @map("last_message_at")
  firstMessageAt         DateTime? @map("first_message_at")  // Track when session became active

  // Presentation state
  currentStage           Int       @default(1) @map("current_stage")

  // Presentation URLs
  blankPresentationUrl   String?   @map("blank_presentation_url") @db.Text
  strawmanPreviewUrl     String?   @map("strawman_preview_url") @db.Text
  finalPresentationUrl   String?   @map("final_presentation_url") @db.Text

  // Presentation IDs for downloads
  blankPresentationId    String?   @map("blank_presentation_id")
  strawmanPresentationId String?   @map("strawman_presentation_id")
  finalPresentationId    String?   @map("final_presentation_id")

  // Slide metadata
  slideCount             Int?      @map("slide_count")

  // Session status
  status                 String    @default("draft")      // 'draft' | 'active' | 'archived' | 'deleted'
  isFavorite             Boolean   @default(false) @map("is_favorite")

  // Gemini File Search Store (NEW ARCHITECTURE)
  geminiStoreName        String?   @map("gemini_store_name") @db.Text  // Full resource name: "fileSearchStores/{store_id}"
  geminiStoreId          String?   @map("gemini_store_id")              // Just the ID part for reference

  // Relations
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages               ChatMessage[]
  stateCache             SessionStateCache?
  uploadedFiles          UploadedFile[]
  publishedDeck          PublishedDeck?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("fe_chat_sessions")
}

// Stores all messages (user and bot) for a session
model ChatMessage {
  id                     String    @id                    // WebSocket message_id
  sessionId              String    @map("session_id")

  // Message metadata
  messageType            String    @map("message_type")   // 'user' | 'chat_message' | 'action_request' | 'slide_update' | 'presentation_url' | 'status_update'
  timestamp              DateTime

  // Message content (JSON for flexibility with different message types)
  payload                Json

  // User messages specific (for quick queries and display)
  userText               String?   @map("user_text") @db.Text

  // Relations
  session                ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp(sort: Asc)])
  @@index([sessionId, messageType])
  @@map("fe_chat_messages")
}

// Stores computed state to quickly restore hook state
model SessionStateCache {
  sessionId              String    @id @map("session_id")

  // Cached state from WebSocket hook
  currentStatus          Json?     @map("current_status")  // Last StatusUpdate payload
  slideStructure         Json?     @map("slide_structure") // Last SlideUpdate payload
  activeVersion          String?   @map("active_version")  // Which presentation version is active: "strawman" or "final"

  // Timestamps
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  session                ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("fe_session_state_cache")
}

// File uploads for RAG-based content generation
model UploadedFile {
  id                String    @id @default(cuid())
  sessionId         String    @map("session_id")
  userId            String    @map("user_id")

  // File metadata
  fileName          String    @map("file_name")
  fileSize          Int       @map("file_size")      // Size in bytes
  fileType          String    @map("file_type")      // MIME type

  // Gemini File API references (NEW ARCHITECTURE)
  geminiFileUri     String    @map("gemini_file_uri") @db.Text  // e.g., "files/abc123"
  geminiFileName    String?   @map("gemini_file_name")          // Gemini's internal file name
  geminiStoreName   String?   @map("gemini_store_name") @db.Text // "fileSearchStores/{store_id}"

  // Upload status tracking
  uploadStatus      String    @default("uploading") @map("upload_status")  // "uploading" | "indexed" | "failed"
  uploadError       String?   @map("upload_error") @db.Text                // Error message if failed

  // Timestamps
  uploadedAt        DateTime  @default(now()) @map("uploaded_at")

  // Relations
  session           ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([uploadedAt(sort: Desc)])
  @@index([geminiStoreName])
  @@map("fe_uploaded_files")
}

// Stripe Subscription Model
model Subscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stripe Fields
  stripeSubscriptionId String   @unique @map("stripe_subscription_id")
  stripeCustomerId     String   @map("stripe_customer_id")
  stripePriceId        String   @map("stripe_price_id")
  stripeProductId      String   @map("stripe_product_id")

  // Subscription Details
  status               String   // "active" | "canceled" | "incomplete" | "incomplete_expired" | "past_due" | "trialing" | "unpaid"
  tier                 String   // "pro" | "enterprise"
  billingCycle         String   // "monthly" | "yearly"

  // Billing Period
  currentPeriodStart   DateTime @map("current_period_start")
  currentPeriodEnd     DateTime @map("current_period_end")
  cancelAtPeriodEnd    Boolean  @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at")

  // Trial Info
  trialStart           DateTime? @map("trial_start")
  trialEnd             DateTime? @map("trial_end")

  // Metadata
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
}

// Stripe Payment Model
model Payment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")

  // Stripe Fields
  stripeInvoiceId      String   @unique @map("stripe_invoice_id")
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")

  // Payment Details
  amount               Int      // Amount in cents
  currency             String   @default("usd")
  status               String   // "paid" | "failed" | "pending"

  // Invoice Details
  invoiceUrl           String?  @map("invoice_url")
  invoicePdf           String?  @map("invoice_pdf")

  // Metadata
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("payments")
  @@index([userId])
  @@index([status])
}

// User notification & privacy preferences (1:1 with User)
model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")

  // Email notification preferences (store-only — no email provider wired yet)
  emailAccountActivity  Boolean  @default(true)  @map("email_account_activity")
  emailProductUpdates   Boolean  @default(true)  @map("email_product_updates")
  emailMarketing        Boolean  @default(false) @map("email_marketing")

  // Privacy preferences
  activityTracking      Boolean  @default(false) @map("activity_tracking")

  // Timestamps
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fe_user_preferences")
}

// Coupon-based authorization + credit wallet
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  valueCents      Int       @map("value_cents")
  currency        String    @default("usd")
  tier            String    @default("starter")
  maxRedemptions  Int?      @map("max_redemptions")
  timesRedeemed   Int       @default(0) @map("times_redeemed")
  perUserLimit    Int       @default(1) @map("per_user_limit")
  expiresAt       DateTime? @map("expires_at")
  active          Boolean   @default(true)
  note            String?
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  redemptions CouponRedemption[]

  @@index([active])
  @@map("fe_coupons")
}

model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String   @map("coupon_id")
  userId      String   @map("user_id")
  amountCents Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
  @@map("fe_coupon_redemptions")
}

model WalletTransaction {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  type             String   // 'credit' | 'debit'
  amountCents      Int      @map("amount_cents")
  reason           String   // 'coupon_redemption' | 'token_usage' | 'card_topup' | 'admin_adjust'
  balanceAfterCents Int     @map("balance_after_cents")
  sourceRef        String?  @unique @map("source_ref")
  tokens           Int?
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reason])
  @@index([userId, reason, createdAt])
  @@map("fe_wallet_transactions")
}

// Published decks — a public snapshot of a built deck served at /p/{slug}.
// One record per ChatSession; republish swaps the snapshot pointer.
model PublishedDeck {
  id                     String    @id @default(cuid())
  slug                   String    @unique                       // 10-char base62 capability token for unlisted links
  userId                 String    @map("user_id")
  sessionId              String    @unique @map("session_id")    // ChatSession.id — one publish record per session
  sourcePresentationId   String    @map("source_presentation_id")   // the live (editable) deck
  snapshotPresentationId String    @map("snapshot_presentation_id") // the frozen copy viewers actually see
  // The SOURCE deck's Layout `updated_at` as of the last publish/republish/rotate.
  // Exact (not clock-based) staleness signal: if the live deck's current
  // updated_at differs from this, the frozen copy viewers see is out of date.
  // Stored as the raw string the Layout Service returns so the comparison is a
  // byte-for-byte equality check with no parse/precision loss. Nullable: the
  // read is best-effort and must never fail a publish (null = "unknown", which
  // reads as "not stale" rather than nagging the owner on every open).
  sourceUpdatedAt        String?   @map("source_updated_at")
  title                  String
  slideCount             Int       @map("slide_count")           // /convert/pptx requires a valid slide_count
  visibility             String    @default("unlisted")          // 'public' | 'unlisted' | 'restricted'
  passcodeHash           String?   @map("passcode_hash")         // scrypt hash; set when visibility = 'restricted'
  allowPdf               Boolean   @default(true) @map("allow_pdf")
  allowPptx              Boolean   @default(true) @map("allow_pptx")
  // Snapshot ids whose Layout-side delete failed (key mismatch / 5xx). Carried
  // here so revocation isn't silently lost; retried opportunistically on the
  // next publish/rotate/unpublish (self-healing — no cron).
  staleSnapshotIds       String[]  @default([]) @map("stale_snapshot_ids")
  // Optimistic-concurrency token. Publish/rotate/unpublish CAS on this (update
  // guarded by the read version + increment) so concurrent lifecycle ops can't
  // lose a stale-snapshot id or orphan a just-created snapshot. Column name
  // matches, so no @map (convention here maps only when names differ).
  version                Int       @default(0)
  viewCount              Int       @default(0) @map("view_count")
  publishedAt            DateTime  @default(now()) @map("published_at")
  republishedAt          DateTime? @map("republished_at")
  revokedAt              DateTime? @map("revoked_at")            // unpublished (row kept so the slug stays reserved)

  // --- Rung 1: grounded Q&A -------------------------------------------------
  // The Researcher session whose corpus backs this deck's Q&A. Today this always
  // equals sessionId, but that equality is a CONVENTION, not a constraint —
  // persist it so the join is a stored fact and a future re-key can't silently
  // break Q&A.
  researcherSessionId String? @map("researcher_session_id")
  // Off by default: a public LLM endpoint on someone's client deck must be a
  // deliberate act, never a side effect of publishing.
  qaEnabled           Boolean @default(false) @map("qa_enabled")
  // 'none' | 'building' | 'ready' | 'partial' | 'failed'
  // 'partial' = slides indexed, but the research corpus was already gone.
  qaCorpusStatus      String  @default("none") @map("qa_corpus_status")
  // The version the corpus was frozen at. A republish invalidates it, and a
  // mismatch defers everything with `not_ready` rather than answering stale.
  qaCorpusVersion     Int?    @map("qa_corpus_version")
  qaDailyCap          Int     @default(50)  @map("qa_daily_cap")
  qaMonthlyCap        Int     @default(500) @map("qa_monthly_cap")
  // Tone: style ONLY. Enforced structurally in Researcher (stage 1 grounds with
  // the tone absent from its context; stage 2 only restyles text that already
  // passed the gates), so no tone can move the refusal threshold.
  qaTonePreset        String  @default("professional") @map("qa_tone_preset")
  qaToneInstruction   String? @map("qa_tone_instruction")
  // Whether PUBLIC web sources may be named to viewers. Deck slides always are
  // (the viewer is looking at them); private uploads and research NEVER are.
  qaCiteWebSources    Boolean @default(true) @map("qa_cite_web_sources")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questions DeckQuestion[]
  faqItems  DeckFaqItem[]
  qaSources PublishedDeckSource[]

  @@index([userId])
  @@map("fe_published_decks")
}

/// A question asked by a viewer on a published deck.
///
/// PRIVATE TO THE ASKER by construction. A deck sent to five clients must never
/// let one see another's questions, so every public read is scoped by
/// askerTokenHash — never by publishedDeckId alone. That is enforced in the
/// query, not in the component.
///
/// Promotion to the public FAQ COPIES into DeckFaqItem; this row is never made
/// public, so promoting one answer can never expose the thread it came from.
model DeckQuestion {
  id              String   @id @default(cuid())
  publishedDeckId String   @map("published_deck_id")

  // --- asker (anonymous by default) ---
  /// sha256 of the follow-up token. The raw token exists only in the asker's
  /// browser and their return link, so a database leak grants access to no thread.
  askerTokenHash  String   @unique @map("asker_token_hash")
  /// sha256(ip + secret). Rate limiting and abuse only; never displayed, not reversible.
  askerIpHash     String   @map("asker_ip_hash")
  askerEmail      String?  @map("asker_email")
  askerName       String?  @map("asker_name")

  question        String
  /// Which deck version was live when asked (PublishedDeck.version).
  deckVersion     Int      @default(0) @map("deck_version")

  // --- the machine attempt ---
  /// 'answered' | 'deferred' | 'owner_answered' | 'blocked'
  status          String   @default("deferred")
  /// 'answered' | 'no_evidence' | 'low_confidence' | 'unverified_claim'
  /// | 'policy' | 'not_ready' | 'capped' | 'disabled' | 'rate_limited'
  gateReason      String?  @map("gate_reason")
  aiAnswer        String?  @map("ai_answer")
  /// The FULL, tier-blind citation set. The owner and the audit trail see
  /// everything, including private source names; only the VIEWER-facing
  /// projection is filtered (see citationsForViewer).
  aiCitations     Json?    @map("ai_citations")
  confidence      Float?
  retrievalTop    Float?   @map("retrieval_top")
  modelUsed       String?  @map("model_used")
  tokensIn        Int?     @map("tokens_in")
  tokensOut       Int?     @map("tokens_out")
  costCents       Int?     @map("cost_cents")

  // --- the human follow-up ---
  ownerAnswer     String?   @map("owner_answer")
  ownerAnsweredAt DateTime? @map("owner_answered_at")
  ownerReadAt     DateTime? @map("owner_read_at")
  askerSeenAt     DateTime? @map("asker_seen_at")

  // --- forward fields for rungs 3–4. Nullable, written by nobody in rung 1.
  // Added now so a later rung needs no migration against a table that by then
  // holds production question history.
  /// 'text' | 'narration' | 'live_chat'
  channel            String?  @default("text")
  spoken             Boolean? @default(false)
  answerAudioUrl     String?  @map("answer_audio_url")
  narrationSessionId String?  @map("narration_session_id")
  liveSessionId      String?  @map("live_session_id")

  createdAt       DateTime  @default(now()) @map("created_at")

  deck PublishedDeck @relation(fields: [publishedDeckId], references: [id], onDelete: Cascade)
  faq  DeckFaqItem?

  @@index([publishedDeckId, createdAt])
  @@index([publishedDeckId, status])
  @@index([askerIpHash, createdAt])
  @@map("fe_deck_questions")
}

/// An owner-approved, PUBLIC Q&A pair shown on /p/{slug}.
///
/// The only text on a published deck that carries the publisher's name — because
/// a human approved it. AI answers never do.
model DeckFaqItem {
  id               String   @id @default(cuid())
  publishedDeckId  String   @map("published_deck_id")
  /// Nullable: an owner may author an FAQ entry with no originating question.
  sourceQuestionId String?  @unique @map("source_question_id")

  question         String
  answer           String
  /// Citations carried over at promotion, already filtered to what a viewer may see.
  citations        Json?
  sortOrder        Int      @default(0) @map("sort_order")
  published        Boolean  @default(true)
  /// Denormalised so the public byline survives a later profile rename.
  approvedByName   String   @map("approved_by_name")
  approvedAt       DateTime @default(now()) @map("approved_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  deck           PublishedDeck @relation(fields: [publishedDeckId], references: [id], onDelete: Cascade)
  sourceQuestion DeckQuestion? @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)

  @@index([publishedDeckId, published, sortOrder])
  @@map("fe_deck_faq_items")
}

/// Publish's OWN decision about which source documents may answer public questions.
///
/// Deliberately lives here, in the publish schema, NOT in knowledge/KG: the two
/// are owned by different teams and must not collide. Keyed by
/// published_qa_chunks.source_ref, so no Researcher table is altered or
/// read-modified by this feature — the decision travels to Researcher on the
/// freeze call and nowhere else.
model PublishedDeckSource {
  id              String   @id @default(cuid())
  publishedDeckId String   @map("published_deck_id")
  sourceRef       String   @map("source_ref")
  /// 'deck' | 'web' | 'document' | 'research'
  sourceKind      String   @map("source_kind")
  /// Owner-facing label only. NEVER serialised to /p/{slug}.
  sourceLabel     String?  @map("source_label")
  chunkCount      Int      @default(0) @map("chunk_count")
  /// Defaults are applied per KIND at freeze time: deck and public web allow,
  /// uploads deny (opt-in), research inherits its parent. The costs are
  /// asymmetric — a denied document is a missed answer (recoverable via the
  /// inbox); an allowed confidential one is a leak (not).
  allowedForQa    Boolean  @default(false) @map("allowed_for_qa")
  updatedAt       DateTime @updatedAt @map("updated_at")

  deck PublishedDeck @relation(fields: [publishedDeckId], references: [id], onDelete: Cascade)

  @@unique([publishedDeckId, sourceRef])
  @@index([publishedDeckId, allowedForQa])
  @@map("fe_published_deck_sources")
}

// Element Conversation Models (for format panel chat-based AI)
